---
import FavoritesShowcase from '../components/FavoritesShowcase.astro';
import HeroTonalField from '../components/HeroTonalField.astro';
import LanyardCard from '../components/LanyardCard.astro';
import NowPlayingPill from '../components/NowPlayingPill.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SocialLinksList from '../components/SocialLinksList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedFavorites } from '../lib/favorites';
import { getLastFmNowPlaying } from '../lib/lastfm';
import { getPublishedProjects } from '../lib/projects';
import { parseAboutParagraphs, resolveSiteContent } from '../lib/site-content';
import { getPublishedSocials } from '../lib/socials';

const [{ content }, projectsResult, socialsResult, favoritesResult, lastFmResult] = await Promise.all([
  resolveSiteContent(Astro.locals),
  getPublishedProjects(Astro.locals.supabase),
  getPublishedSocials(Astro.locals.supabase),
  getPublishedFavorites(Astro.locals.supabase),
  getLastFmNowPlaying(),
]);

const aboutParagraphs = parseAboutParagraphs(content.aboutParagraphs);
---

<BaseLayout
  title={content.brand}
  description={content.metaDescription}
  includeStructuredData={true}
>
  <!-- Hero -->
  <section id="top" aria-labelledby="hero-heading" class="relative isolate z-20 overflow-x-clip pt-10 pb-12 sm:pt-16 sm:pb-16 lg:pt-20 lg:pb-24">
    <HeroTonalField />
    <div class="container-page grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-start lg:gap-12">
      <div class="min-w-0 space-y-6">
        {content.heroEyebrow && <p class="text-label-lg text-primary">{content.heroEyebrow}</p>}

        <h1
          id="hero-heading"
          class="text-display-sm tracking-tight text-on-surface sm:text-display-md lg:text-display-lg text-balance"
        >
          {content.heroHeading}
        </h1>

        <p class="max-w-xl whitespace-pre-line text-body-lg leading-relaxed text-on-surface-variant text-pretty">
          {content.heroBio}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href={content.heroPrimaryCtaHref} class="btn btn-accent">{content.heroPrimaryCtaLabel}</a>
          <a href={content.heroSecondaryCtaHref} class="btn btn-outlined">{content.heroSecondaryCtaLabel}</a>
        </div>

        <div class="pt-1">
          <NowPlayingPill result={lastFmResult} />
        </div>
      </div>

      <LanyardCard
        brand={content.brand}
        owner={content.owner}
        role={content.role}
        focus={content.cardFocus}
        workflow={content.cardWorkflow}
        stack={content.cardStack}
      />
    </div>
  </section>

  <!-- Projects -->
  <ProjectsSection
    result={projectsResult}
    heading={content.projectsHeading}
    subtitle={content.projectsSubtitle}
    showAdmin={Astro.locals.isAdmin}
  />

  <!-- About & Skills -->
  <section id="about" aria-labelledby="about-heading" class="py-12 sm:py-16 lg:py-20">
    <div class="container-page grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-12">
      <div class="space-y-4">
        <h2 id="about-heading" class="text-headline-sm text-on-surface sm:text-headline-md text-balance">
          {content.aboutHeading}
        </h2>
        {
          aboutParagraphs.map((paragraph, index) => (
            <p class:list={[index === 0 ? 'text-body-lg' : 'text-body-md', 'text-on-surface-variant text-pretty']}>
              {paragraph}
            </p>
          ))
        }
      </div>

      <div class="divide-y divide-outline-variant/50 rounded-xl bg-surface-container-low">
        {
          content.skills.map((group) => (
            <div class="grid gap-4 p-5 sm:grid-cols-[0.8fr_1.2fr] sm:items-start sm:p-6">
              <div class="space-y-1">
                <h3 class="text-title-md text-on-surface">{group.title}</h3>
                {group.note && <p class="text-body-sm text-on-surface-variant">{group.note}</p>}
              </div>
              <ul class="flex flex-wrap gap-2" aria-label={`${group.title} skills`}>
                {group.items.map((item) => (
                  <li class="chip-assist">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Social Media -->
  <section id="socials" aria-labelledby="socials-heading" class="py-12 sm:py-16 lg:py-20">
    <div class="container-page space-y-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl space-y-2">
          <h2 id="socials-heading" class="text-headline-sm text-on-surface sm:text-headline-md text-balance">
            {content.socialsHeading}
          </h2>
          {content.socialsSubtitle && <p class="text-body-lg text-on-surface-variant">{content.socialsSubtitle}</p>}
        </div>
        <a href="/socials" class="btn btn-outlined self-start sm:self-end">
          {content.socialsCtaLabel}
        </a>
      </div>

      <SocialLinksList result={socialsResult} compact={true} headingLevel="h3" showAdmin={Astro.locals.isAdmin} />
    </div>
  </section>

  <!-- Favorites -->
  <section id="favorites" aria-labelledby="favorites-heading" class="py-12 pb-16 sm:py-16 sm:pb-20 lg:py-20 lg:pb-24">
    <div class="container-page space-y-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl space-y-2">
          <h2 id="favorites-heading" class="text-headline-sm text-on-surface sm:text-headline-md text-balance">
            Favorites
          </h2>
          <p class="text-body-lg text-on-surface-variant text-pretty">
            YouTube channels I watch, live Last.fm scrobbles, and games on rotation.
          </p>
        </div>
        <a href="/favorites" class="btn btn-outlined self-start sm:self-end">
          Open favorites page
        </a>
      </div>

      <FavoritesShowcase
        mode="section"
        content={content}
        favoritesResult={favoritesResult}
        lastFmResult={lastFmResult}
        socialsResult={socialsResult}
        isAdmin={Astro.locals.isAdmin}
      />
    </div>
  </section>
</BaseLayout>
