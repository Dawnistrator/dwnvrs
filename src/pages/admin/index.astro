---
import { actions, isInputError } from 'astro:actions';
import BrandMark from '../../components/BrandMark.astro';
import Icon from '../../components/Icon.astro';
import SocialBrandIcon, { SOCIAL_BRAND_PRESETS } from '../../components/SocialBrandIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { FavoriteCategory, FavoriteItemRow, ProjectRow, SocialLinkRow } from '../../lib/database.types';
import { isMissingFavoritesTableError, normalizeFavoriteCoverUrl } from '../../lib/favorites';
import { resolveSiteContent } from '../../lib/site-content';

const logoutResult = Astro.getActionResult(actions.admin.logout);
if (logoutResult?.data?.ok) {
  return Astro.redirect('/admin/login');
}

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
if (!supabase || !user || !Astro.locals.isAdmin) {
  return Astro.redirect('/admin/login');
}

const saveProjectResult = Astro.getActionResult(actions.admin.saveProject);
const deleteProjectResult = Astro.getActionResult(actions.admin.deleteProject);
const saveSocialResult = Astro.getActionResult(actions.admin.saveSocial);
const deleteSocialResult = Astro.getActionResult(actions.admin.deleteSocial);
const saveFavoriteResult = Astro.getActionResult(actions.admin.saveFavorite);
const deleteFavoriteResult = Astro.getActionResult(actions.admin.deleteFavorite);
const saveSectionsResult = Astro.getActionResult(actions.admin.saveSiteContent);

if (deleteProjectResult?.data?.ok) {
  return Astro.redirect('/admin?deleted=project');
}
if (saveSocialResult?.data) {
  return Astro.redirect(`/admin?tab=socials&savedSocial=${encodeURIComponent(saveSocialResult.data.platform)}`);
}
if (deleteSocialResult?.data?.ok) {
  return Astro.redirect('/admin?tab=socials&deleted=social');
}
if (saveFavoriteResult?.data) {
  return Astro.redirect(`/admin?tab=favorites&savedFavorite=${encodeURIComponent(saveFavoriteResult.data.title)}`);
}
if (deleteFavoriteResult?.data?.ok) {
  return Astro.redirect('/admin?tab=favorites&deleted=favorite');
}
if (saveSectionsResult?.data?.ok) {
  return Astro.redirect('/admin?tab=sections&savedSections=1');
}

const editParam = Astro.url.searchParams.get('edit');
const editSocialParam = Astro.url.searchParams.get('editSocial');
const editFavoriteParam = Astro.url.searchParams.get('editFavorite');
const categoryParam = Astro.url.searchParams.get('category');
const tabParam = Astro.url.searchParams.get('tab');
const savedSlugParam = Astro.url.searchParams.get('saved');
const savedSocialParam = Astro.url.searchParams.get('savedSocial');
const savedFavoriteParam = Astro.url.searchParams.get('savedFavorite');
const savedSectionsParam = Astro.url.searchParams.get('savedSections');
const deletedParam = Astro.url.searchParams.get('deleted');

let initialTab: 'projects' | 'socials' | 'favorites' | 'sections' =
  tabParam === 'socials'
    ? 'socials'
    : tabParam === 'favorites'
      ? 'favorites'
      : tabParam === 'sections'
        ? 'sections'
        : 'projects';
if (saveSocialResult || deleteSocialResult || editSocialParam) {
  initialTab = 'socials';
} else if (saveFavoriteResult || deleteFavoriteResult || editFavoriteParam) {
  initialTab = 'favorites';
} else if (saveSectionsResult) {
  initialTab = 'sections';
}

const [projectsRes, socialsRes, favoritesRes, siteContentResult] = await Promise.all([
  supabase
    .from('projects')
    .select('*')
    .order('featured', { ascending: false })
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: false }),
  supabase
    .from('social_links')
    .select('*')
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: true }),
  supabase
    .from('favorite_items')
    .select('*')
    .order('category', { ascending: true })
    .order('sort_order', { ascending: true })
    .order('featured', { ascending: false })
    .order('created_at', { ascending: false }),
  resolveSiteContent(Astro.locals),
]);

const projects: ProjectRow[] = projectsRes.data ?? [];
const socialLinks: SocialLinkRow[] = socialsRes.data ?? [];
const favoriteItems: FavoriteItemRow[] = (favoritesRes.data ?? []).map((item) => ({
  ...item,
  cover_url: normalizeFavoriteCoverUrl(item.cover_url),
}));
const homeContent = siteContentResult.content;
const siteContentMissingTable =
  siteContentResult.status === 'fallback' && siteContentResult.reason === 'missing-table';
const favoritesMissingTable = Boolean(
  favoritesRes.error && isMissingFavoritesTableError(favoritesRes.error.code, favoritesRes.error.message),
);

const editingProject =
  editParam && !deleteProjectResult?.data?.ok ? projects.find((p) => p.id === editParam) ?? null : null;
const editingSocial =
  editSocialParam && !deleteSocialResult?.data?.ok ? socialLinks.find((s) => s.id === editSocialParam) ?? null : null;
const editingFavorite =
  editFavoriteParam && !deleteFavoriteResult?.data?.ok
    ? favoriteItems.find((f) => f.id === editFavoriteParam) ?? null
    : null;

const saveFieldErrors = saveProjectResult?.error && isInputError(saveProjectResult.error) ? saveProjectResult.error.fields : {};
const saveTopError =
  saveProjectResult?.error && !isInputError(saveProjectResult.error) ? saveProjectResult.error.message : null;

const socialFieldErrors = saveSocialResult?.error && isInputError(saveSocialResult.error) ? saveSocialResult.error.fields : {};
const socialTopError =
  saveSocialResult?.error && !isInputError(saveSocialResult.error) ? saveSocialResult.error.message : null;

const favoriteFieldErrors =
  saveFavoriteResult?.error && isInputError(saveFavoriteResult.error) ? saveFavoriteResult.error.fields : {};
const favoriteTopError =
  saveFavoriteResult?.error && !isInputError(saveFavoriteResult.error) ? saveFavoriteResult.error.message : null;

const sectionsFieldErrors = saveSectionsResult?.error && isInputError(saveSectionsResult.error) ? saveSectionsResult.error.fields : {};
const sectionsTopError =
  saveSectionsResult?.error && !isInputError(saveSectionsResult.error) ? saveSectionsResult.error.message : null;

const favoriteCategoryOptions: { value: FavoriteCategory; label: string }[] = [
  { value: 'game', label: 'Game' },
  { value: 'movie', label: 'YouTube Channel' },
  { value: 'music', label: 'Music' },
];
const favoriteCategoryLabel: Record<FavoriteCategory, string> = {
  game: 'Game',
  movie: 'YouTube',
  music: 'Music',
};
const favoriteSectionTitle: Record<FavoriteCategory, string> = {
  game: 'Games',
  movie: 'YouTube Channels',
  music: 'Music',
};
const favoriteGroups = (['game', 'movie', 'music'] as FavoriteCategory[])
  .map((cat) => ({
    category: cat,
    label: favoriteSectionTitle[cat],
    items: favoriteItems.filter((item) => item.category === cat),
  }))
  .filter((group) => group.items.length > 0);
const initialFavCategory: FavoriteCategory =
  editingFavorite?.category ??
  (categoryParam === 'movie' || categoryParam === 'music' || categoryParam === 'game' ? categoryParam : 'game');
const favSearchPlaceholderMap: Record<FavoriteCategory, string> = {
  game: 'Search game (e.g. Silent Hill 2, Persona 5, Hollow Knight)...',
  movie: 'Search YouTube channel (e.g. LTT, Linus Tech Tips, Fireship, MKBHD)...',
  music: 'Search track or artist (e.g. Daft Punk, Nujabes)...',
};

let snackbarMessage: string | null = null;
if (saveProjectResult?.data) {
  snackbarMessage = saveProjectResult.data.created
    ? `Project "${saveProjectResult.data.slug}" created.`
    : `Project "${saveProjectResult.data.slug}" updated.`;
} else if (savedSlugParam) {
  snackbarMessage = `Project "${savedSlugParam}" saved.`;
} else if (savedSocialParam) {
  snackbarMessage = `Social link "${savedSocialParam}" saved.`;
} else if (savedFavoriteParam) {
  snackbarMessage = `Favorite "${savedFavoriteParam}" saved.`;
} else if (savedSectionsParam === '1') {
  snackbarMessage = 'Home page sections updated.';
} else if (deletedParam === 'project') {
  snackbarMessage = 'Project deleted.';
} else if (deletedParam === 'social') {
  snackbarMessage = 'Social link deleted.';
} else if (deletedParam === 'favorite') {
  snackbarMessage = 'Favorite entry deleted.';
}
---

<BaseLayout
  title={`Admin | ${homeContent.brand}`}
  description={`Manage portfolio projects, home page sections, and social media links for ${homeContent.brand}.`}
  hidePublicNav={true}
  robots="noindex, nofollow"
  snackbarMessage={snackbarMessage}
>
  <header class="sticky top-0 z-30 border-b border-outline-variant/50 bg-surface">
    <div class="container-page flex min-h-16 flex-wrap items-center justify-between gap-3 py-2">
      <div class="flex items-center gap-3">
        <a
          href="/admin"
          class="state-layer inline-flex min-h-11 items-center gap-2.5 rounded-full px-3 text-title-md font-bold text-on-surface"
        >
          <BrandMark class="size-6 shrink-0 text-on-surface" />
          <span>{homeContent.brand} Admin</span>
        </a>
        {user.email && <span class="hidden text-body-sm text-on-surface-variant sm:inline">{user.email}</span>}
      </div>

      <div class="flex items-center gap-2">
        <a href="/favorites" class="btn btn-text px-4">Favorites page</a>
        <a href="/socials" class="btn btn-text px-4">Socials page</a>
        <a href="/" class="btn btn-outlined px-4">
          <span>Public site</span>
          <Icon name="open-in-new" />
        </a>
        <form method="POST" action={actions.admin.logout}>
          <button type="submit" class="btn btn-tonal px-4">
            <Icon name="logout" />
            <span>Sign out</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <div class="container-page space-y-8 py-8 sm:py-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-1">
        <h1 class="text-headline-md text-on-surface sm:text-headline-lg">Workspace</h1>
        <p class="text-body-md text-on-surface-variant">
          Create or update portfolio projects, manage social links, and edit all home page sections.
        </p>
      </div>

      <!-- M3 Tab Bar -->
      <div
        role="tablist"
        aria-label="Admin sections"
        data-admin-tabs
        class="inline-flex w-full flex-wrap rounded-full bg-surface-container p-1 sm:w-auto"
      >
        <button
          id="tab-projects"
          type="button"
          role="tab"
          aria-selected={initialTab === 'projects' ? 'true' : 'false'}
          aria-controls="panel-projects"
          tabindex={initialTab === 'projects' ? 0 : -1}
          data-tab="projects"
          class="state-layer flex-1 rounded-full min-h-11 px-4 text-label-lg transition-colors aria-selected:bg-secondary-container aria-selected:text-on-secondary-container text-on-surface-variant sm:flex-none sm:px-5"
        >
          Projects ({projects.length})
        </button>
        <button
          id="tab-socials"
          type="button"
          role="tab"
          aria-selected={initialTab === 'socials' ? 'true' : 'false'}
          aria-controls="panel-socials"
          tabindex={initialTab === 'socials' ? 0 : -1}
          data-tab="socials"
          class="state-layer flex-1 rounded-full min-h-11 px-4 text-label-lg transition-colors aria-selected:bg-secondary-container aria-selected:text-on-secondary-container text-on-surface-variant sm:flex-none sm:px-5"
        >
          Socials ({socialLinks.length})
        </button>
        <button
          id="tab-favorites"
          type="button"
          role="tab"
          aria-selected={initialTab === 'favorites' ? 'true' : 'false'}
          aria-controls="panel-favorites"
          tabindex={initialTab === 'favorites' ? 0 : -1}
          data-tab="favorites"
          class="state-layer flex-1 rounded-full min-h-11 px-4 text-label-lg transition-colors aria-selected:bg-secondary-container aria-selected:text-on-secondary-container text-on-surface-variant sm:flex-none sm:px-5"
        >
          Favorites ({favoriteItems.length})
        </button>
        <button
          id="tab-sections"
          type="button"
          role="tab"
          aria-selected={initialTab === 'sections' ? 'true' : 'false'}
          aria-controls="panel-sections"
          tabindex={initialTab === 'sections' ? 0 : -1}
          data-tab="sections"
          class="state-layer flex-1 rounded-full min-h-11 px-4 text-label-lg transition-colors aria-selected:bg-secondary-container aria-selected:text-on-secondary-container text-on-surface-variant sm:flex-none sm:px-5"
        >
          Home sections
        </button>
      </div>
    </div>

    <!-- Projects Tab Panel -->
    <section
      id="panel-projects"
      role="tabpanel"
      aria-labelledby="tab-projects"
      hidden={initialTab !== 'projects'}
      class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start"
    >
      <!-- Project Editor -->
      <div class="card-filled rounded-xl p-6 sm:p-7 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-headline-sm text-on-surface">
            {editingProject ? `Edit: ${editingProject.title}` : 'New project'}
          </h2>
          {
            editingProject && (
              <a href="/admin" class="btn btn-text">
                Cancel edit
              </a>
            )
          }
        </div>

        <form
          method="POST"
          action={actions.admin.saveProject}
          enctype="multipart/form-data"
          data-project-form
          data-is-edit={editingProject ? 'true' : 'false'}
          class="space-y-5"
        >
          {editingProject && <input type="hidden" name="id" value={editingProject.id} />}

          <div
            hidden={!saveTopError}
            data-project-alert
            role="alert"
            class="flex items-start gap-3 rounded-lg bg-error-container p-4 text-body-md text-on-error-container"
          >
            <Icon name="error" class="mt-0.5 size-5" />
            <p data-project-alert-text>{saveTopError ?? ''}</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <input
                id="proj-title"
                name="title"
                type="text"
                required
                maxlength={120}
                placeholder=" "
                value={editingProject?.title ?? ''}
                aria-invalid={saveFieldErrors.title ? 'true' : undefined}
                aria-describedby="proj-title-error"
                class="field-input"
              />
              <label for="proj-title" class="field-label">Title</label>
              <p id="proj-title-error" class="field-error">
                <Icon name="error" />
                <span data-error-for="title">{saveFieldErrors.title?.[0] ?? 'Enter a title.'}</span>
              </p>
            </div>

            <div class="field">
              <input
                id="proj-slug"
                name="slug"
                type="text"
                maxlength={80}
                placeholder=" "
                value={editingProject?.slug ?? ''}
                aria-invalid={saveFieldErrors.slug ? 'true' : undefined}
                aria-describedby="proj-slug-support proj-slug-error"
                class="field-input"
              />
              <label for="proj-slug" class="field-label">Slug (URL path)</label>
              <p id="proj-slug-support" class="field-support">Lowercase letters, numbers, and hyphens.</p>
              <p id="proj-slug-error" class="field-error">
                <Icon name="error" />
                <span data-error-for="slug">{saveFieldErrors.slug?.[0] ?? 'Check the slug format.'}</span>
              </p>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-[1.4fr_0.6fr]">
            <div class="field">
              <input
                id="proj-category"
                name="category"
                type="text"
                required
                maxlength={40}
                list="category-options"
                placeholder=" "
                value={editingProject?.category ?? 'Web App'}
                aria-invalid={saveFieldErrors.category ? 'true' : undefined}
                aria-describedby="proj-category-error"
                class="field-input"
              />
              <label for="proj-category" class="field-label">Category</label>
              <datalist id="category-options">
                <option value="Website" />
                <option value="Web App" />
                <option value="Mobile App" />
                <option value="API / Tool" />
              </datalist>
              <p id="proj-category-error" class="field-error">
                <Icon name="error" />
                <span data-error-for="category">{saveFieldErrors.category?.[0] ?? 'Enter a category.'}</span>
              </p>
            </div>

            <div class="field">
              <input
                id="proj-order"
                name="sort_order"
                type="number"
                min={-9999}
                max={9999}
                placeholder=" "
                value={editingProject?.sort_order ?? 0}
                aria-invalid={saveFieldErrors.sort_order ? 'true' : undefined}
                aria-describedby="proj-order-error"
                class="field-input"
              />
              <label for="proj-order" class="field-label">Sort order</label>
              <p id="proj-order-error" class="field-error">
                <Icon name="error" />
                <span data-error-for="sort_order">{saveFieldErrors.sort_order?.[0] ?? 'Whole number.'}</span>
              </p>
            </div>
          </div>

          <div class="field">
            <textarea
              id="proj-summary"
              name="summary"
              required
              maxlength={300}
              placeholder=" "
              aria-invalid={saveFieldErrors.summary ? 'true' : undefined}
              aria-describedby="proj-summary-support proj-summary-error"
              class="field-input min-h-24!"
            >{editingProject?.summary ?? ''}</textarea>
            <label for="proj-summary" class="field-label">Summary</label>
            <p id="proj-summary-support" class="field-support">Shown on cards, up to 300 characters.</p>
            <p id="proj-summary-error" class="field-error">
              <Icon name="error" />
              <span data-error-for="summary">{saveFieldErrors.summary?.[0] ?? 'Write a short summary.'}</span>
            </p>
          </div>

          <div class="field">
            <textarea
              id="proj-content"
              name="content"
              maxlength={20000}
              placeholder=" "
              aria-invalid={saveFieldErrors.content ? 'true' : undefined}
              aria-describedby="proj-content-support proj-content-error"
              class="field-input"
            >{editingProject?.content ?? ''}</textarea>
            <label for="proj-content" class="field-label">Case study details</label>
            <p id="proj-content-support" class="field-support">
              Supports section headings, bullet or numbered lists (- / 1.), **bold** lead-ins, and paragraphs separated by a blank line.
            </p>
            <p id="proj-content-error" class="field-error">
              <Icon name="error" />
              <span data-error-for="content">{saveFieldErrors.content?.[0] ?? 'Keep under 20,000 characters.'}</span>
            </p>
          </div>

          <div class="field">
            <input
              id="proj-stack"
              name="tech_stack"
              type="text"
              maxlength={500}
              placeholder=" "
              value={editingProject?.tech_stack.join(', ') ?? ''}
              aria-invalid={saveFieldErrors.tech_stack ? 'true' : undefined}
              aria-describedby="proj-stack-support"
              class="field-input"
            />
            <label for="proj-stack" class="field-label">Tech stack (comma-separated)</label>
            <p id="proj-stack-support" class="field-support">Example: Astro, TypeScript, Tailwind CSS, Supabase</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <input
                id="proj-live"
                name="live_url"
                type="url"
                maxlength={500}
                placeholder=" "
                value={editingProject?.live_url ?? ''}
                aria-invalid={saveFieldErrors.live_url ? 'true' : undefined}
                aria-describedby="proj-live-error"
                class="field-input"
              />
              <label for="proj-live" class="field-label">Live URL (optional)</label>
              <p id="proj-live-error" class="field-error">
                <Icon name="error" />
                <span data-error-for="live_url">{saveFieldErrors.live_url?.[0] ?? 'Start with https://'}</span>
              </p>
            </div>

            <div class="field">
              <input
                id="proj-repo"
                name="repo_url"
                type="url"
                maxlength={500}
                placeholder=" "
                value={editingProject?.repo_url ?? ''}
                aria-invalid={saveFieldErrors.repo_url ? 'true' : undefined}
                aria-describedby="proj-repo-error"
                class="field-input"
              />
              <label for="proj-repo" class="field-label">Repository URL (optional)</label>
              <p id="proj-repo-error" class="field-error">
                <Icon name="error" />
                <span data-error-for="repo_url">{saveFieldErrors.repo_url?.[0] ?? 'Start with https://'}</span>
              </p>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <label class="state-layer flex min-h-11 items-center gap-3 rounded-lg bg-surface-container-high px-4 py-2 text-body-md text-on-surface">
              <input
                type="checkbox"
                name="featured"
                class="checkbox"
                checked={editingProject?.featured ?? false}
              />
              <span>Featured on home</span>
            </label>

            <label class="state-layer flex min-h-11 items-center gap-3 rounded-lg bg-surface-container-high px-4 py-2 text-body-md text-on-surface">
              <input
                type="checkbox"
                name="published"
                class="checkbox"
                checked={editingProject ? editingProject.published : true}
              />
              <span>Published</span>
            </label>
          </div>

          <div class="space-y-3 rounded-lg border border-outline-variant p-4">
            <label for="proj-thumbnail" class="block text-title-sm text-on-surface">
              Thumbnail image (max 4 MB)
            </label>
            <input
              id="proj-thumbnail"
              name="thumbnail"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
              class="block w-full text-body-sm text-on-surface-variant file:mr-4 file:min-h-11 file:rounded-full file:border-0 file:bg-secondary-container file:px-4 file:text-label-lg file:text-on-secondary-container"
            />
            {
              editingProject?.thumbnail_url && (
                <div class="space-y-2 pt-2">
                  <img
                    src={editingProject.thumbnail_url}
                    alt={`${editingProject.title} thumbnail`}
                    width={320}
                    height={200}
                    class="aspect-[16/10] w-44 rounded-sm object-cover"
                  />
                  <label class="inline-flex min-h-11 items-center gap-2 text-body-sm text-error">
                    <input type="checkbox" name="remove_thumbnail" class="checkbox" />
                    <span>Remove current thumbnail</span>
                  </label>
                </div>
              )
            }
          </div>

          <div class="space-y-3 rounded-lg border border-outline-variant p-4">
            <label for="proj-gallery" class="block text-title-sm text-on-surface">
              Gallery screenshots (optional, 4.4 MB total per save)
            </label>
            <input
              id="proj-gallery"
              name="gallery"
              type="file"
              multiple
              accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
              class="block w-full text-body-sm text-on-surface-variant file:mr-4 file:min-h-11 file:rounded-full file:border-0 file:bg-secondary-container file:px-4 file:text-label-lg file:text-on-secondary-container"
            />
            {
              editingProject && editingProject.gallery_urls.length > 0 && (
                <div class="grid grid-cols-2 gap-3 pt-2 sm:grid-cols-3">
                  {editingProject.gallery_urls.map((url, idx) => (
                    <div class="space-y-1.5 rounded-sm bg-surface-container-high p-2">
                      <img
                        src={url}
                        alt={`Gallery ${idx + 1}`}
                        width={240}
                        height={150}
                        class="aspect-[16/10] w-full rounded-xs object-cover"
                      />
                      <label class="flex min-h-11 items-center gap-2 text-body-sm text-error">
                        <input type="checkbox" name="remove_gallery" value={url} class="checkbox" />
                        <span>Remove</span>
                      </label>
                    </div>
                  ))}
                </div>
              )
            }
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-1">
            <button type="submit" class="btn btn-accent" data-project-submit>
              <Icon name={editingProject ? 'edit' : 'add'} />
              <span>{editingProject ? 'Save changes' : 'Create project'}</span>
            </button>
            {
              editingProject && (
                <a href="/admin" class="btn btn-outlined">
                  New project instead
                </a>
              )
            }
          </div>
        </form>
      </div>

      <!-- Existing Projects List -->
      <div class="space-y-4">
        <h2 class="text-headline-sm text-on-surface">All projects</h2>

        {
          projectsRes.error ? (
            <div role="alert" class="rounded-card border border-error bg-surface-container-low p-6 space-y-2">
              <p class="text-title-md text-error">Could not load projects</p>
