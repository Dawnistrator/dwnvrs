                  class="field-input"
                />
                <label for="sec-soc-heading" class="field-label">Socials heading</label>
                <p id="sec-soc-heading-error" class="field-error">
                  <Icon name="error" />
                  <span data-section-error-for="socials_heading">
                    {sectionsFieldErrors.socials_heading?.[0] ?? 'Enter a Socials heading.'}
                  </span>
                </p>
              </div>

              <div class="field">
                <textarea
                  id="sec-soc-subtitle"
                  name="socials_subtitle"
                  maxlength={300}
                  placeholder=" "
                  aria-invalid={sectionsFieldErrors.socials_subtitle ? 'true' : undefined}
                  aria-describedby="sec-soc-subtitle-error"
                  class="field-input min-h-24!"
                >{homeContent.socialsSubtitle}</textarea>
                <label for="sec-soc-subtitle" class="field-label">Socials subtitle (optional)</label>
                <p id="sec-soc-subtitle-error" class="field-error">
                  <Icon name="error" />
                  <span data-section-error-for="socials_subtitle">
                    {sectionsFieldErrors.socials_subtitle?.[0] ?? 'Keep under 300 characters.'}
                  </span>
                </p>
              </div>

              <div class="field">
                <input
                  id="sec-soc-cta"
                  name="socials_cta_label"
                  type="text"
                  required
                  maxlength={60}
                  placeholder=" "
                  value={homeContent.socialsCtaLabel}
                  aria-invalid={sectionsFieldErrors.socials_cta_label ? 'true' : undefined}
                  aria-describedby="sec-soc-cta-error"
                  class="field-input"
                />
                <label for="sec-soc-cta" class="field-label">Directory button text</label>
                <p id="sec-soc-cta-error" class="field-error">
                  <Icon name="error" />
                  <span data-section-error-for="socials_cta_label">
                    {sectionsFieldErrors.socials_cta_label?.[0] ?? 'Enter button label.'}
                  </span>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 6. About & Skills Full-Width Card -->
        <div class="card-filled rounded-xl p-6 sm:p-7 space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="space-y-1">
              <h2 class="text-headline-sm text-on-surface">6. About &amp; skills</h2>
              <p class="text-body-sm text-on-surface-variant">
                Edit your About story and manage the categorized skill chips displayed on the home page.
              </p>
            </div>
            <button type="button" class="btn btn-tonal px-4" data-add-skill-group>
              <Icon name="add" />
              <span>Add skill category</span>
            </button>
          </div>

          <div class="grid gap-5 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
            <div class="space-y-5">
              <div class="field">
                <input
                  id="sec-about-heading"
                  name="about_heading"
                  type="text"
                  required
                  maxlength={100}
                  placeholder=" "
                  value={homeContent.aboutHeading}
                  aria-invalid={sectionsFieldErrors.about_heading ? 'true' : undefined}
                  aria-describedby="sec-about-heading-error"
                  class="field-input"
                />
                <label for="sec-about-heading" class="field-label">About heading</label>
                <p id="sec-about-heading-error" class="field-error">
                  <Icon name="error" />
                  <span data-section-error-for="about_heading">
                    {sectionsFieldErrors.about_heading?.[0] ?? 'Enter an About heading.'}
                  </span>
                </p>
              </div>

              <div class="field">
                <textarea
                  id="sec-about-body"
                  name="about_paragraphs"
                  maxlength={2000}
                  placeholder=" "
                  aria-invalid={sectionsFieldErrors.about_paragraphs ? 'true' : undefined}
                  aria-describedby="sec-about-body-support sec-about-body-error"
                  class="field-input min-h-40!"
                >{homeContent.aboutParagraphs}</textarea>
                <label for="sec-about-body" class="field-label">About paragraphs</label>
                <p id="sec-about-body-support" class="field-support">
                  Separate paragraphs with a blank line. First paragraph uses larger lead text.
                </p>
                <p id="sec-about-body-error" class="field-error">
                  <Icon name="error" />
                  <span data-section-error-for="about_paragraphs">
                    {sectionsFieldErrors.about_paragraphs?.[0] ?? 'Keep under 2,000 characters.'}
                  </span>
                </p>
              </div>
            </div>

            <div class="space-y-4" data-skill-groups-list>
              {
                homeContent.skills.map((group, idx) => (
                  <div class="card-elevated space-y-4 rounded-lg p-4 sm:p-5" data-skill-group>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <div class="field">
                        <input
                          id={`skill-title-${idx}`}
                          name="skill_title"
                          type="text"
                          required
                          maxlength={60}
                          placeholder=" "
                          aria-label="Category title"
                          value={group.title}
                          class="field-input"
                        />
                        <label for={`skill-title-${idx}`} class="field-label">Category title</label>
                      </div>

                      <div class="field">
                        <input
                          id={`skill-note-${idx}`}
                          name="skill_note"
                          type="text"
                          maxlength={120}
                          placeholder=" "
                          aria-label="Short subtitle (optional)"
                          value={group.note}
                          class="field-input"
                        />
                        <label for={`skill-note-${idx}`} class="field-label">Short subtitle (optional)</label>
                      </div>
                    </div>

                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                      <div class="field flex-1">
                        <input
                          id={`skill-items-${idx}`}
                          name="skill_items"
                          type="text"
                          maxlength={600}
                          placeholder=" "
                          aria-label="Skills (comma-separated)"
                          value={group.items.join(', ')}
                          class="field-input"
                        />
                        <label for={`skill-items-${idx}`} class="field-label">Skills (comma-separated)</label>
                      </div>
                      <button
                        type="button"
                        class="btn btn-text shrink-0 self-start text-error sm:mt-1.5"
                        data-remove-skill-group
                      >
                        <Icon name="delete" />
                        <span>Remove</span>
                      </button>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-surface-container-low p-5">
          <button type="submit" class="btn btn-accent" data-sections-submit>
            <Icon name="check" />
            <span>Save home sections</span>
          </button>
          <a href="/" class="btn btn-outlined">
            <span>View home page</span>
            <Icon name="open-in-new" />
          </a>
        </div>
      </form>

      <template id="skill-group-template">
        <div class="card-elevated space-y-4 rounded-lg p-4 sm:p-5" data-skill-group>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="field">
              <input
                name="skill_title"
                type="text"
                required
                maxlength={60}
                placeholder=" "
                aria-label="Category title"
                class="field-input"
              />
              <label class="field-label">Category title</label>
            </div>

            <div class="field">
              <input
                name="skill_note"
                type="text"
                maxlength={120}
                placeholder=" "
                aria-label="Short subtitle (optional)"
                class="field-input"
              />
              <label class="field-label">Short subtitle (optional)</label>
            </div>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
            <div class="field flex-1">
              <input
                name="skill_items"
                type="text"
                maxlength={600}
                placeholder=" "
                aria-label="Skills (comma-separated)"
                class="field-input"
              />
              <label class="field-label">Skills (comma-separated)</label>
            </div>
            <button type="button" class="btn btn-text shrink-0 self-start text-error sm:mt-1.5" data-remove-skill-group>
              <Icon name="delete" />
              <span>Remove</span>
            </button>
          </div>
        </div>
      </template>
    </section>
  </div>

  <!-- M3 Basic Dialog for destructive actions -->
  <dialog id="confirm-delete-dialog" class="m3-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-body">
    <div class="space-y-4">
      <h2 id="confirm-title" class="text-headline-sm text-on-surface" data-dialog-title>
        Confirm delete
      </h2>
      <p id="confirm-body" class="text-body-md text-on-surface-variant" data-dialog-body>
        This action cannot be undone.
      </p>
      <div class="flex flex-wrap justify-end gap-2 pt-2">
        <button type="button" class="btn btn-text" data-dialog-cancel>Cancel</button>
        <button type="button" class="btn btn-danger" data-dialog-confirm>Delete permanently</button>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { actions, isInputError } from 'astro:actions';

  /* ---------- Tabs ---------- */
  const tabList = document.querySelector<HTMLElement>('[data-admin-tabs]');
  const tabs = Array.from(tabList?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const panels = new Map<string, HTMLElement>();
  for (const tab of tabs) {
    const targetId = tab.getAttribute('aria-controls');
    const panel = targetId ? document.getElementById(targetId) : null;
    if (tab.dataset.tab && panel) panels.set(tab.dataset.tab, panel);
  }

  function activateTab(tabName: string, moveFocus = false) {
    for (const tab of tabs) {
      const selected = tab.dataset.tab === tabName;
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      tab.tabIndex = selected ? 0 : -1;
      if (selected && moveFocus) tab.focus();
    }
    for (const [name, panel] of panels) {
      panel.hidden = name !== tabName;
    }
    const url = new URL(window.location.href);
    if (tabName === 'projects') {
      url.searchParams.delete('tab');
    } else {
      url.searchParams.set('tab', tabName);
    }
    history.replaceState(null, '', url);
  }

  tabList?.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[role="tab"]') : null;
    if (btn?.dataset.tab) activateTab(btn.dataset.tab);
  });

  for (const switchBtn of document.querySelectorAll<HTMLButtonElement>('[data-switch-tab]')) {
    switchBtn.addEventListener('click', () => {
      const target = switchBtn.dataset.switchTab;
      if (target) {
        activateTab(target, true);
        window.scrollTo(0, 0);
      }
    });
  }

  tabList?.addEventListener('keydown', (e) => {
    const currentIndex = tabs.findIndex((t) => t === document.activeElement);
    if (currentIndex === -1) return;
    let nextIndex = -1;
    if (e.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
    else if (e.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
    else if (e.key === 'Home') nextIndex = 0;
    else if (e.key === 'End') nextIndex = tabs.length - 1;
    if (nextIndex !== -1) {
      e.preventDefault();
      const targetTab = tabs[nextIndex]?.dataset.tab;
      if (targetTab) activateTab(targetTab, true);
    }
  });

  /* ---------- Project Form ---------- */
  const projectForm = document.querySelector<HTMLFormElement>('[data-project-form]');
  if (projectForm) {
    const isEdit = projectForm.dataset.isEdit === 'true';
    const titleInput = projectForm.elements.namedItem('title') as HTMLInputElement | null;
    const slugInput = projectForm.elements.namedItem('slug') as HTMLInputElement | null;
    let slugEdited = isEdit || Boolean(slugInput?.value);

    function toSlug(val: string): string {
      return val
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80)
        .replace(/-+$/g, '');
    }

    slugInput?.addEventListener('input', () => {
      slugEdited = Boolean(slugInput.value.trim());
    });

    titleInput?.addEventListener('input', () => {
      if (!slugEdited && slugInput) {
        slugInput.value = toSlug(titleInput.value);
      }
    });

    projectForm.noValidate = true;
    const submitBtn = projectForm.querySelector<HTMLButtonElement>('[data-project-submit]');
    const alertBox = projectForm.querySelector<HTMLElement>('[data-project-alert]');
    const alertText = projectForm.querySelector<HTMLElement>('[data-project-alert-text]');

    function clearProjectErrors() {
      if (alertBox) alertBox.hidden = true;
      for (const el of projectForm!.querySelectorAll<HTMLElement>('.field-input')) {
        el.removeAttribute('aria-invalid');
      }
    }

    function setProjectFieldError(name: string, message: string) {
      const input = projectForm!.elements.namedItem(name) as HTMLElement | null;
      const errSpan = projectForm!.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (input) input.setAttribute('aria-invalid', 'true');
      if (errSpan) errSpan.textContent = message;
    }

    projectForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearProjectErrors();

      const thumbInput = projectForm.elements.namedItem('thumbnail') as HTMLInputElement | null;
      const galleryInput = projectForm.elements.namedItem('gallery') as HTMLInputElement | null;
      let totalBytes = 0;
      for (const file of [...(thumbInput?.files ?? []), ...(galleryInput?.files ?? [])]) {
        if (file.size > 4 * 1024 * 1024) {
          const msg = `"${file.name}" is larger than 4 MB.`;
          if (alertBox && alertText) {
            alertText.textContent = msg;
            alertBox.hidden = false;
          }
          return;
        }
        totalBytes += file.size;
      }
      if (totalBytes > 4.4 * 1024 * 1024) {
        if (alertBox && alertText) {
          alertText.textContent = 'Total uploaded image size per save must be under 4.4 MB.';
          alertBox.hidden = false;
        }
        return;
      }

      const originalLabel = submitBtn?.querySelector('span')?.textContent ?? 'Save';
      if (submitBtn) {
        submitBtn.disabled = true;
        const label = submitBtn.querySelector('span');
        if (label) label.textContent = 'Saving...';
      }

      try {
        const { data, error } = await actions.admin.saveProject(new FormData(projectForm));
        if (error) {
          if (isInputError(error)) {
            let focused = false;
            for (const [key, messages] of Object.entries(error.fields)) {
              const msg = messages?.[0];
              if (msg) {
                setProjectFieldError(key, msg);
                if (!focused) {
                  const fieldEl = projectForm.elements.namedItem(key);
                  if (fieldEl instanceof HTMLElement) {
                    fieldEl.focus();
                    focused = true;
                  }
                }
              }
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: 'Check the highlighted fields.' } }));
          } else {
            if (alertBox && alertText) {
              alertText.textContent = error.message;
              alertBox.hidden = false;
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: error.message } }));
          }
          return;
        }

        if (data?.slug) {
          window.location.assign(`/admin?saved=${encodeURIComponent(data.slug)}`);
        }
      } catch {
        const msg = 'Network error while saving project.';
        if (alertBox && alertText) {
          alertText.textContent = msg;
          alertBox.hidden = false;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          const label = submitBtn.querySelector('span');
          if (label) label.textContent = originalLabel;
        }
      }
    });
  }

  /* ---------- Social Link Form ---------- */
  const socialForm = document.querySelector<HTMLFormElement>('[data-social-form]');
  if (socialForm) {
    socialForm.noValidate = true;
    const presetGroup = socialForm.querySelector<HTMLElement>('[data-social-presets]');
    const platformInput = socialForm.elements.namedItem('platform') as HTMLInputElement | null;
    const urlInput = socialForm.elements.namedItem('url') as HTMLInputElement | null;
    const submitBtn = socialForm.querySelector<HTMLButtonElement>('[data-social-submit]');
    const alertBox = socialForm.querySelector<HTMLElement>('[data-social-alert]');
    const alertText = socialForm.querySelector<HTMLElement>('[data-social-alert-text]');

    function syncPresetButtons() {
      const current = (platformInput?.value ?? '').trim().toLowerCase();
      for (const btn of presetGroup?.querySelectorAll<HTMLButtonElement>('[data-preset-platform]') ?? []) {
        const match = (btn.dataset.presetPlatform ?? '').toLowerCase() === current;
        btn.setAttribute('aria-pressed', match ? 'true' : 'false');
      }
    }

    presetGroup?.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-preset-platform]') : null;
      const value = btn?.dataset.presetPlatform;
      if (value && platformInput) {
        platformInput.value = value;
        platformInput.removeAttribute('aria-invalid');
        syncPresetButtons();
        const handleInput = socialForm.elements.namedItem('handle');
        if (value === 'Email' && urlInput && !urlInput.value.trim()) {
          urlInput.focus();
        } else if (handleInput instanceof HTMLElement) {
          handleInput.focus();
        }
      }
    });

    platformInput?.addEventListener('input', syncPresetButtons);

    function clearSocialErrors() {
      if (alertBox) alertBox.hidden = true;
      for (const el of socialForm!.querySelectorAll<HTMLElement>('.field-input')) {
        el.removeAttribute('aria-invalid');
      }
    }

    function setSocialFieldError(name: string, message: string) {
      const input = socialForm!.elements.namedItem(name) as HTMLElement | null;
      const errSpan = socialForm!.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (input) input.setAttribute('aria-invalid', 'true');
      if (errSpan) errSpan.textContent = message;
    }

    socialForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearSocialErrors();

      const originalLabel = submitBtn?.querySelector('span')?.textContent ?? 'Save';
      if (submitBtn) {
        submitBtn.disabled = true;
        const label = submitBtn.querySelector('span');
        if (label) label.textContent = 'Saving...';
      }

      try {
        const { data, error } = await actions.admin.saveSocial(new FormData(socialForm));
        if (error) {
          if (isInputError(error)) {
            let focused = false;
            for (const [key, messages] of Object.entries(error.fields)) {
              const msg = messages?.[0];
              if (msg) {
                setSocialFieldError(key, msg);
                if (!focused) {
                  const fieldEl = socialForm.elements.namedItem(key);
                  if (fieldEl instanceof HTMLElement) {
                    fieldEl.focus();
                    focused = true;
                  }
                }
              }
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: 'Check the highlighted fields.' } }));
          } else {
            if (alertBox && alertText) {
              alertText.textContent = error.message;
              alertBox.hidden = false;
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: error.message } }));
          }
          return;
        }

        if (data?.platform) {
          window.location.assign(`/admin?tab=socials&savedSocial=${encodeURIComponent(data.platform)}`);
        }
      } catch {
        const msg = 'Network error while saving social link.';
        if (alertBox && alertText) {
          alertText.textContent = msg;
          alertBox.hidden = false;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          const label = submitBtn.querySelector('span');
          if (label) label.textContent = originalLabel;
        }
      }
    });
  }

  /* ---------- Favorite Item Form ---------- */
  const favoriteForm = document.querySelector<HTMLFormElement>('[data-favorite-form]');
  if (favoriteForm) {
    favoriteForm.noValidate = true;
    const catPresetGroup = favoriteForm.querySelector<HTMLElement>('[data-fav-category-presets]');
    const catInput = favoriteForm.elements.namedItem('category') as HTMLInputElement | null;
    const submitBtn = favoriteForm.querySelector<HTMLButtonElement>('[data-favorite-submit]');
    const alertBox = favoriteForm.querySelector<HTMLElement>('[data-favorite-alert]');
    const alertText = favoriteForm.querySelector<HTMLElement>('[data-favorite-alert-text]');

    const searchInput = document.getElementById('fav-search-query') as HTMLInputElement | null;
    const searchBtn = favoriteForm.querySelector<HTMLButtonElement>('[data-fav-search-btn]');
    const searchStatus = favoriteForm.querySelector<HTMLElement>('[data-fav-search-status]');
    const searchResultsEl = favoriteForm.querySelector<HTMLElement>('[data-fav-search-results]');

    const favSearchPlaceholders: Record<string, string> = {
      game: 'Search game (e.g. Silent Hill 2, Persona 5, Hollow Knight)...',
      movie: 'Search YouTube channel (e.g. LTT, Linus Tech Tips, Fireship, MKBHD)...',
      music: 'Search track or artist (e.g. Daft Punk, Nujabes)...',
    };

    function syncFavCategoryButtons(value: string) {
      for (const btn of catPresetGroup?.querySelectorAll<HTMLButtonElement>('[data-fav-cat-preset]') ?? []) {
        btn.setAttribute('aria-pressed', btn.dataset.favCatPreset === value ? 'true' : 'false');
      }
      if (searchInput) {
        searchInput.placeholder = favSearchPlaceholders[value] ?? favSearchPlaceholders.game;
      }
    }

    catPresetGroup?.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-fav-cat-preset]') : null;
      const val = btn?.dataset.favCatPreset;
      if (val && catInput) {
        catInput.value = val;
        syncFavCategoryButtons(val);
      }
    });

    /* ---------- Auto-Fetch Cover / Channel & Metadata Search ---------- */

    interface MediaCandidate {
      title: string;
      subtitle: string;
      coverUrl: string | null;
      externalUrl: string | null;
      accentColor: string;
      source: string;
      review?: string;
    }

    function applyMediaCandidate(candidate: MediaCandidate) {
      const titleField = favoriteForm!.elements.namedItem('title') as HTMLInputElement | null;
      const subtitleField = favoriteForm!.elements.namedItem('subtitle') as HTMLInputElement | null;
      const reviewField = favoriteForm!.elements.namedItem('review') as HTMLTextAreaElement | null;
      const coverUrlField = favoriteForm!.elements.namedItem('cover_url') as HTMLInputElement | null;
      const externalUrlField = favoriteForm!.elements.namedItem('external_url') as HTMLInputElement | null;
      const accentField = favoriteForm!.elements.namedItem('accent_color') as HTMLInputElement | null;

      if (titleField) {
        titleField.value = candidate.title;
        titleField.removeAttribute('aria-invalid');
      }
      if (subtitleField && candidate.subtitle) {
        subtitleField.value = candidate.subtitle;
      }
      if (reviewField && candidate.review && !reviewField.value.trim()) {
        reviewField.value = candidate.review;
      }
      if (coverUrlField && candidate.coverUrl) {
        coverUrlField.value = candidate.coverUrl;
        coverUrlField.removeAttribute('aria-invalid');
      }
      if (externalUrlField && candidate.externalUrl) {
        externalUrlField.value = candidate.externalUrl;
        externalUrlField.removeAttribute('aria-invalid');
      }
      if (accentField && candidate.accentColor) {
        accentField.value = candidate.accentColor;
      }

      window.dispatchEvent(
        new CustomEvent('app:snackbar', { detail: { message: `Filled details for "${candidate.title}".` } }),
      );
      titleField?.focus();
    }

    async function runMediaSearch() {
      const q = (searchInput?.value ?? '').trim();
      const category = catInput?.value ?? 'game';
      if (!searchStatus || !searchResultsEl) return;

      if (q.length < 2) {
        searchStatus.textContent = 'Enter at least 2 characters to search.';
        searchStatus.classList.remove('hidden');
        searchResultsEl.classList.add('hidden');
        return;
      }

      if (searchBtn) searchBtn.disabled = true;
      searchStatus.textContent =
        category === 'movie' ? 'Searching YouTube channels...' : 'Searching covers and metadata...';
      searchStatus.classList.remove('hidden');
      searchResultsEl.replaceChildren();
      searchResultsEl.classList.add('hidden');

      try {
        const res = await fetch(
          `/api/media-search.json?category=${encodeURIComponent(category)}&q=${encodeURIComponent(q)}`,
          { headers: { Accept: 'application/json' } },
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const payload = (await res.json()) as { results?: MediaCandidate[] };
        const items = payload.results ?? [];

        if (items.length === 0) {
          const categoryName = category === 'movie' ? 'YouTube channels' : category;
          searchStatus.textContent = `No results found for "${q}" in ${categoryName}. Try another query or paste details manually.`;
          return;
        }

        searchStatus.textContent = `Found ${items.length} matches. Click one to fill the form:`;
        for (const item of items) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'state-layer flex min-h-14 items-center gap-3 rounded-md border border-outline-variant/60 bg-surface-container-high p-2.5 text-left transition-colors hover:border-primary';

          if (item.coverUrl) {
            const img = document.createElement('img');
            img.src = item.coverUrl;
            img.alt = '';
            img.loading = 'lazy';
            img.referrerPolicy = 'no-referrer';
            if (category === 'movie') {
              img.width = 44;
              img.height = 44;
              img.className = 'size-11 shrink-0 rounded-full object-cover bg-surface-container-lowest';
            } else {
              img.width = 48;
              img.height = 72;
              img.className = 'aspect-[2/3] w-10 shrink-0 rounded-xs object-cover bg-surface-container-lowest';
            }
            btn.appendChild(img);
          }

          const info = document.createElement('div');
          info.className = 'min-w-0 flex-1 space-y-0.5';

          const titleEl = document.createElement('p');
          titleEl.className = 'truncate text-label-lg text-on-surface';
          titleEl.textContent = item.title;

          const metaEl = document.createElement('p');
          metaEl.className = 'truncate text-body-sm text-on-surface-variant';
          metaEl.textContent = item.subtitle ? `${item.source} · ${item.subtitle}` : item.source;

          info.append(titleEl, metaEl);
          btn.appendChild(info);
          btn.addEventListener('click', () => applyMediaCandidate(item));
          searchResultsEl.appendChild(btn);
        }
        searchResultsEl.classList.remove('hidden');
      } catch {
        searchStatus.textContent = 'Search failed. Check your internet connection or paste details manually.';
      } finally {
        if (searchBtn) searchBtn.disabled = false;
      }
    }

    searchBtn?.addEventListener('click', runMediaSearch);
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        runMediaSearch();
      }
    });

    function clearFavoriteErrors() {
      if (alertBox) alertBox.hidden = true;
      for (const el of favoriteForm!.querySelectorAll<HTMLElement>('.field-input')) {
        el.removeAttribute('aria-invalid');
      }
    }

    function setFavoriteFieldError(name: string, message: string) {
      const input = favoriteForm!.elements.namedItem(name) as HTMLElement | null;
      const errSpan = favoriteForm!.querySelector<HTMLElement>(`[data-fav-error-for="${name}"]`);
      if (input) input.setAttribute('aria-invalid', 'true');
      if (errSpan) errSpan.textContent = message;
    }

    favoriteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearFavoriteErrors();

      const coverInput = favoriteForm.elements.namedItem('cover') as HTMLInputElement | null;
      const file = coverInput?.files?.[0];
      if (file && file.size > 4 * 1024 * 1024) {
        if (alertBox && alertText) {
          alertText.textContent = `"${file.name}" is larger than 4 MB.`;
          alertBox.hidden = false;
        }
        return;
      }

      const originalLabel = submitBtn?.querySelector('span')?.textContent ?? 'Save';
      if (submitBtn) {
        submitBtn.disabled = true;
        const label = submitBtn.querySelector('span');
        if (label) label.textContent = 'Saving...';
      }

      try {
        const { data, error } = await actions.admin.saveFavorite(new FormData(favoriteForm));
        if (error) {
          if (isInputError(error)) {
            let focused = false;
            for (const [key, messages] of Object.entries(error.fields)) {
              const msg = messages?.[0];
              if (msg) {
                setFavoriteFieldError(key, msg);
                if (!focused) {
                  const fieldEl = favoriteForm.elements.namedItem(key);
                  if (fieldEl instanceof HTMLElement) {
                    fieldEl.focus();
                    focused = true;
                  }
                }
              }
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: 'Check the highlighted fields.' } }));
          } else {
            if (alertBox && alertText) {
              alertText.textContent = error.message;
              alertBox.hidden = false;
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: error.message } }));
          }
          return;
        }

        if (data?.title) {
          window.location.assign(`/admin?tab=favorites&savedFavorite=${encodeURIComponent(data.title)}`);
        }
      } catch {
        const msg = 'Network error while saving favorite.';
        if (alertBox && alertText) {
          alertText.textContent = msg;
          alertBox.hidden = false;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          const label = submitBtn.querySelector('span');
          if (label) label.textContent = originalLabel;
        }
      }
    });
  }

  /* ---------- Sortable Favorites Reordering ---------- */
  const reorderStatusEl = document.querySelector<HTMLElement>('[data-fav-reorder-status]');
  const sortableLists = Array.from(document.querySelectorAll<HTMLUListElement>('[data-fav-sortable-list]'));

  function getListIds(list: HTMLUListElement): string[] {
    return Array.from(list.querySelectorAll<HTMLElement>('[data-fav-item]'))
      .map((el) => el.dataset.favId ?? '')
      .filter(Boolean);
  }

  function syncSortableListUI(list: HTMLUListElement) {
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-fav-item]'));
    items.forEach((item, idx) => {
      const rankEl = item.querySelector<HTMLElement>('[data-fav-rank]');
      if (rankEl) rankEl.textContent = `#${idx + 1}`;

      const upBtn = item.querySelector<HTMLButtonElement>('[data-fav-move="up"]');
      const downBtn = item.querySelector<HTMLButtonElement>('[data-fav-move="down"]');
      if (upBtn) upBtn.disabled = idx === 0;
      if (downBtn) downBtn.disabled = idx === items.length - 1;
    });
  }

  let reorderSaveSeq = 0;

  async function persistFavoriteOrder(list: HTMLUListElement) {
    const ids = getListIds(list);
    if (ids.length === 0) return;

    const seq = ++reorderSaveSeq;
    if (reorderStatusEl) reorderStatusEl.textContent = 'Saving order...';

    try {
      const { error } = await actions.admin.reorderFavorites({ ids });
      if (seq !== reorderSaveSeq) return;
      if (error) {
        if (reorderStatusEl) reorderStatusEl.textContent = error.message;
        window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: error.message } }));
        return;
      }

      if (reorderStatusEl) reorderStatusEl.textContent = 'Order saved';
      window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: 'Order saved.' } }));
    } catch {
      if (seq !== reorderSaveSeq) return;
      const msg = 'Could not save order.';
      if (reorderStatusEl) reorderStatusEl.textContent = msg;
      window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: msg } }));
    }
  }

  for (const list of sortableLists) {
    let draggingItem: HTMLElement | null = null;
    let initialIds: string[] = [];

    list.addEventListener('dragstart', (e) => {
      const target = e.target;
      if (target instanceof Element && target.closest('a, button, input, textarea, select')) {
        e.preventDefault();
        return;
      }
      const item = target instanceof Element ? target.closest<HTMLElement>('[data-fav-item]') : null;
      if (!item || !list.contains(item)) return;

      draggingItem = item;
      initialIds = getListIds(list);
      item.classList.add('opacity-60');
      if (e.dataTransfer) {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', item.dataset.favId ?? '');
      }
    });

    list.addEventListener('dragover', (e) => {
      if (!draggingItem) return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';

      const overItem = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-fav-item]') : null;
      if (!overItem || overItem === draggingItem || !list.contains(overItem)) return;

      const rect = overItem.getBoundingClientRect();
      const insertAfter = e.clientY > rect.top + rect.height / 2;
      if (insertAfter) {
        if (overItem.nextElementSibling !== draggingItem) {
          list.insertBefore(draggingItem, overItem.nextElementSibling);
          syncSortableListUI(list);
        }
      } else if (overItem !== draggingItem.nextElementSibling) {
        list.insertBefore(draggingItem, overItem);
        syncSortableListUI(list);
      }
    });

    list.addEventListener('drop', (e) => {
      if (!draggingItem) return;
      e.preventDefault();
    });

    list.addEventListener('dragend', () => {
      if (!draggingItem) return;
      draggingItem.classList.remove('opacity-60');
      draggingItem = null;
      syncSortableListUI(list);

      const nextIds = getListIds(list);
      const changed =
        initialIds.length === nextIds.length && initialIds.some((id, idx) => id !== nextIds[idx]);
      if (changed) {
        persistFavoriteOrder(list);
      }
    });

    list.addEventListener('click', (e) => {
      const moveBtn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-fav-move]') : null;
      if (!moveBtn || moveBtn.disabled) return;

      const item = moveBtn.closest<HTMLElement>('[data-fav-item]');
      if (!item || !list.contains(item)) return;

      const direction = moveBtn.dataset.favMove;
      if (direction === 'up' && item.previousElementSibling instanceof HTMLElement) {
        list.insertBefore(item, item.previousElementSibling);
      } else if (direction === 'down' && item.nextElementSibling instanceof HTMLElement) {
        list.insertBefore(item.nextElementSibling, item);
      } else {
        return;
      }

      syncSortableListUI(list);
      if (moveBtn.disabled) {
        const fallbackBtn = item.querySelector<HTMLButtonElement>(
          `[data-fav-move="${direction === 'up' ? 'down' : 'up'}"]`,
        );
        fallbackBtn?.focus();
      } else {
        moveBtn.focus();
      }
      persistFavoriteOrder(list);
    });
  }

  /* ---------- Home Sections Form ---------- */
  const sectionsForm = document.querySelector<HTMLFormElement>('[data-sections-form]');
  if (sectionsForm) {
    sectionsForm.noValidate = true;
    const skillList = sectionsForm.querySelector<HTMLElement>('[data-skill-groups-list]');
    const addGroupBtn = document.querySelector<HTMLButtonElement>('[data-add-skill-group]');
    const groupTemplate = document.getElementById('skill-group-template') as HTMLTemplateElement | null;
    const submitBtn = sectionsForm.querySelector<HTMLButtonElement>('[data-sections-submit]');
    const alertBox = sectionsForm.querySelector<HTMLElement>('[data-sections-alert]');
    const alertText = sectionsForm.querySelector<HTMLElement>('[data-sections-alert-text]');

    function syncRemoveButtons() {
      const cards = Array.from(skillList?.querySelectorAll<HTMLElement>('[data-skill-group]') ?? []);
      const disableRemove = cards.length <= 1;
      for (const btn of cards.map((card) => card.querySelector<HTMLButtonElement>('[data-remove-skill-group]'))) {
        if (btn) btn.disabled = disableRemove;
      }
    }

    syncRemoveButtons();

    addGroupBtn?.addEventListener('click', () => {
      if (!skillList || !groupTemplate) return;
      const cards = skillList.querySelectorAll('[data-skill-group]');
      if (cards.length >= 12) {
        window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: 'Maximum of 12 skill categories.' } }));
        return;
      }
      const fragment = groupTemplate.content.cloneNode(true) as DocumentFragment;
      skillList.appendChild(fragment);
      syncRemoveButtons();
      const addedTitle = skillList.lastElementChild?.querySelector<HTMLInputElement>('input[name="skill_title"]');
      addedTitle?.focus();
    });

    skillList?.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-remove-skill-group]') : null;
      if (!btn || btn.disabled) return;
      const card = btn.closest<HTMLElement>('[data-skill-group]');
      if (card && skillList.querySelectorAll('[data-skill-group]').length > 1) {
        card.remove();
        syncRemoveButtons();
      }
    });

    function clearSectionsErrors() {
      if (alertBox) alertBox.hidden = true;
      for (const el of sectionsForm!.querySelectorAll<HTMLElement>('.field-input')) {
        el.removeAttribute('aria-invalid');
      }
    }

    function setSectionFieldError(name: string, message: string) {
      const input = sectionsForm!.elements.namedItem(name);
      const errSpan = sectionsForm!.querySelector<HTMLElement>(`[data-section-error-for="${name}"]`);
      if (input instanceof HTMLElement) input.setAttribute('aria-invalid', 'true');
      if (errSpan) errSpan.textContent = message;
    }

    sectionsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearSectionsErrors();

      const originalLabel = submitBtn?.querySelector('span')?.textContent ?? 'Save home sections';
      if (submitBtn) {
        submitBtn.disabled = true;
        const label = submitBtn.querySelector('span');
        if (label) label.textContent = 'Saving...';
      }

      try {
        const { data, error } = await actions.admin.saveSiteContent(new FormData(sectionsForm));
        if (error) {
          if (isInputError(error)) {
            let focused = false;
            for (const [key, messages] of Object.entries(error.fields)) {
              const msg = messages?.[0];
              if (msg) {
                setSectionFieldError(key, msg);
                if (!focused) {
                  const fieldEl = sectionsForm.elements.namedItem(key);
                  if (fieldEl instanceof HTMLElement) {
                    fieldEl.focus();
                    focused = true;
                  }
                }
              }
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: 'Check the highlighted fields.' } }));
          } else {
            if (alertBox && alertText) {
              alertText.textContent = error.message;
              alertBox.hidden = false;
            }
            window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: error.message } }));
          }
          return;
        }

        if (data?.ok) {
          window.location.assign('/admin?tab=sections&savedSections=1');
        }
      } catch {
        const msg = 'Network error while saving home sections.';
        if (alertBox && alertText) {
          alertText.textContent = msg;
          alertBox.hidden = false;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          const label = submitBtn.querySelector('span');
          if (label) label.textContent = originalLabel;
        }
      }
    });
  }

  /* ---------- Delete confirmation dialog ---------- */
  const dialog = document.getElementById('confirm-delete-dialog') as HTMLDialogElement | null;
  const dialogTitle = dialog?.querySelector<HTMLElement>('[data-dialog-title]');
  const dialogBody = dialog?.querySelector<HTMLElement>('[data-dialog-body]');
  const dialogCancel = dialog?.querySelector<HTMLButtonElement>('[data-dialog-cancel]');
  const dialogConfirm = dialog?.querySelector<HTMLButtonElement>('[data-dialog-confirm]');
  let pendingForm: HTMLFormElement | null = null;

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-confirm-form]')) {
    form.addEventListener('submit', (e) => {
      if (form.dataset.confirmed === 'true' || !dialog) return;
      e.preventDefault();
      pendingForm = form;
      if (dialogTitle) dialogTitle.textContent = form.dataset.confirmTitle ?? 'Confirm delete';
      if (dialogBody) dialogBody.textContent = form.dataset.confirmBody ?? 'This action cannot be undone.';
      dialog.showModal();
    });
  }

  dialogCancel?.addEventListener('click', () => {
    pendingForm = null;
    dialog?.close();
  });

  dialogConfirm?.addEventListener('click', () => {
    const form = pendingForm;
    pendingForm = null;
    dialog?.close();
    if (form) {
      form.dataset.confirmed = 'true';
      form.requestSubmit();
    }
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      pendingForm = null;
      dialog.close();
    }
  });
</script>
