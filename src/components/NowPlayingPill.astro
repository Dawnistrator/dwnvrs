---
import { getLastFmNowPlaying, type LastFmResult } from '../lib/lastfm';
import { monogram } from '../lib/projects';
import Icon from './Icon.astro';

interface Props {
  result?: LastFmResult;
}

const result = Astro.props.result ?? (await getLastFmNowPlaying());
---

{
  result.status !== 'not-configured' && (
    <a
      href="/favorites"
      data-home-lfm-pill
      data-lfm-state={result.status}
      aria-label={
        result.status === 'ok'
          ? `${result.track.relativeTime}: ${result.track.title} by ${result.track.artist}. Open Favorites page`
          : 'Open Favorites page for music, games, and YouTube'
      }
      class="state-layer group inline-flex max-w-full min-h-11 items-center gap-3 rounded-full border border-outline-variant/70 bg-surface-container-low py-1.5 pr-4 pl-2 transition-colors hover:border-primary/60 hover:bg-surface-container"
    >
      <div class="relative size-8 shrink-0 overflow-hidden rounded-full bg-surface-container-high">
        <img
          data-pill-cover
          src={result.status === 'ok' && result.track.coverUrl ? result.track.coverUrl : ''}
          alt=""
          width={64}
          height={64}
          loading="eager"
          class:list={[
            'h-full w-full object-cover',
            !(result.status === 'ok' && result.track.coverUrl) && 'hidden',
          ]}
        />
        <span
          data-pill-monogram
          aria-hidden="true"
          class:list={[
            'flex h-full w-full items-center justify-center bg-primary-container text-label-sm font-bold text-on-primary-container',
            result.status === 'ok' && result.track.coverUrl && 'hidden',
          ]}
        >
          {result.status === 'ok' ? monogram(result.track.title) : 'FM'}
        </span>
      </div>

      <div class="min-w-0 flex-1 text-left">
        <div class="flex items-center gap-1.5">
          <span
            data-pill-eq
            data-playing={result.status === 'ok' && result.track.nowPlaying && !result.stale ? 'true' : 'false'}
            class="pill-eq"
            aria-hidden="true"
          >
            <span />
            <span />
            <span />
          </span>
          <span data-pill-status class="text-label-sm text-primary">
            {result.status === 'ok'
              ? result.track.relativeTime
              : result.status === 'empty'
                ? 'Last.fm'
                : 'Music & Media'}
          </span>
        </div>
        <p data-pill-track class="truncate text-label-lg text-on-surface group-hover:text-primary">
          {result.status === 'ok'
            ? `${result.track.title} · ${result.track.artist}`
            : 'Open games, YouTube & music'}
        </p>
      </div>

      <span class="hidden shrink-0 rounded-full bg-surface-container-high px-2.5 py-1 text-label-sm text-on-surface-variant sm:inline-flex">
        Favorites
      </span>
      <Icon name="open-in-new" class="size-4 shrink-0 text-on-surface-variant sm:hidden" />
    </a>
  )
}

<style>
  .pill-eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 10px;
  }

  .pill-eq > span {
    width: 2px;
    border-radius: 9999px;
    background: var(--md-sys-color-primary);
    height: 55%;
  }

  .pill-eq > span:nth-child(2) {
    height: 100%;
  }

  .pill-eq > span:nth-child(3) {
    height: 45%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pill-eq:not([data-playing='false']) > span {
      transform-origin: bottom center;
      animation: pill-eq-bounce 1.1s var(--md-sys-motion-easing-standard) infinite alternate;
    }
    .pill-eq:not([data-playing='false']) > span:nth-child(2) {
      animation-delay: 0.25s;
    }
    .pill-eq:not([data-playing='false']) > span:nth-child(3) {
      animation-delay: 0.5s;
    }
  }

  @keyframes pill-eq-bounce {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>

<script>
  const pill = document.querySelector<HTMLAnchorElement>('[data-home-lfm-pill]');
  const pillCover = pill?.querySelector<HTMLImageElement>('[data-pill-cover]');
  const pillMono = pill?.querySelector<HTMLElement>('[data-pill-monogram]');
  const pillEq = pill?.querySelector<HTMLElement>('[data-pill-eq]');
  const pillStatus = pill?.querySelector<HTMLElement>('[data-pill-status]');
  const pillTrack = pill?.querySelector<HTMLElement>('[data-pill-track]');

  function pillMonogram(title: string): string {
    const words = title.replace(/[^\p{L}\p{N}\s]/gu, '').trim().split(/\s+/).filter(Boolean);
    const letters = words.length > 1 ? `${words[0]![0]}${words[1]![0]}` : (words[0] ?? '?').slice(0, 2);
    return letters.toUpperCase();
  }

  type PillLastFmPayload =
    | {
        status: 'ok';
        stale?: boolean;
        track: {
          title: string;
          artist: string;
          coverUrl: string | null;
          nowPlaying: boolean;
          relativeTime: string;
        };
      }
    | { status: 'empty' | 'not-configured' | 'error' };

  function applyPillPayload(payload: PillLastFmPayload) {
    if (!pill) return;
    pill.dataset.lfmState = payload.status;
    if (payload.status !== 'ok') return;

    const t = payload.track;
    pill.setAttribute('aria-label', `${t.relativeTime}: ${t.title} by ${t.artist}. Open Favorites page`);
    if (pillStatus) pillStatus.textContent = t.relativeTime;
    if (pillTrack) pillTrack.textContent = `${t.title} · ${t.artist}`;
    if (pillEq) pillEq.dataset.playing = t.nowPlaying && !payload.stale ? 'true' : 'false';

    if (pillCover && pillMono) {
      if (t.coverUrl && /^https?:\/\//i.test(t.coverUrl)) {
        pillCover.src = t.coverUrl;
        pillCover.classList.remove('hidden');
        pillMono.classList.add('hidden');
      } else {
        pillCover.removeAttribute('src');
        pillCover.classList.add('hidden');
        pillMono.textContent = pillMonogram(t.title);
        pillMono.classList.remove('hidden');
      }
    }
  }

  async function refreshHomePill() {
    if (!pill) return;
    try {
      const res = await fetch('/api/now-playing.json', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const payload = (await res.json()) as PillLastFmPayload;
      applyPillPayload(payload);
    } catch {
      /* keep current SSR state */
    }
  }

  if (pill) {
    window.addEventListener('app:lastfm', (event) => {
      const payload = (event as CustomEvent<PillLastFmPayload>).detail;
      if (payload) applyPillPayload(payload);
    });

    if (!document.querySelector('[data-favorites-root]')) {
      window.setInterval(() => {
        if (document.visibilityState === 'visible') refreshHomePill();
      }, 20_000);
    }
  }
</script>
