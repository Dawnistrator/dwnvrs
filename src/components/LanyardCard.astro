---
import { site } from '../config/site';
import BrandMark from './BrandMark.astro';

interface Props {
  brand?: string;
  owner?: string;
  role?: string;
  focus?: string;
  workflow?: string;
  stack?: string;
}

const {
  brand = site.brand,
  owner = site.owner,
  role = site.role,
  focus = site.card.focus,
  workflow = site.card.workflow,
  stack = site.card.stack,
} = Astro.props;

const details = [
  { label: 'Focus', value: focus },
  { label: 'Workflow', value: workflow },
  { label: 'Stack', value: stack },
].filter((row) => row.value.trim().length > 0);
---

<aside aria-label="Developer ID card" class="flex justify-center lg:-mt-20 lg:justify-end">
  <div class="relative flex w-full max-w-xs flex-col items-center select-none sm:max-w-sm">
    <!-- Anchor ring at the top of the lanyard (connects to the top bar on desktop) -->
    <div
      aria-hidden="true"
      class="z-10 h-2.5 w-10 rounded-full border border-outline bg-surface-container-high lg:rounded-t-none lg:border-t-0"
    ></div>

    <!-- Pivoting assembly: strap + clasp + hook + M3 card (origin locked inside navbar ring) -->
    <div
      data-lanyard-rig
      class="-mt-2 flex w-full origin-[50%_6px] flex-col items-center"
    >
      <!-- Lanyard strap -->
      <div
        aria-hidden="true"
        data-lanyard-strap
        class="relative flex h-10 w-8 origin-top flex-col items-center justify-center overflow-hidden border-x border-outline-variant/60 bg-primary-container lg:h-24"
      >
        <span class="h-full w-1.5 bg-accent/85"></span>
      </div>

      <!-- Moving payload locked cleanly to bottom of stretched strap -->
      <div
        data-lanyard-payload
        class="flex w-full origin-top flex-col items-center"
      >
        <!-- Clasp hardware + hook pin reaching into the card slot -->
        <div
          aria-hidden="true"
          class="z-20 -mt-1 flex flex-col items-center"
        >
          <div class="flex h-4 w-10 items-center justify-center rounded-xs border border-outline bg-surface-container-highest">
            <span class="h-1 w-4 rounded-full bg-outline"></span>
          </div>
          <span class="h-4 w-2 rounded-b-full border border-t-0 border-outline bg-surface-container-high"></span>
        </div>

        <!-- M3 ID Card -->
        <div
          data-lanyard-card
          class="card-filled relative -mt-2.5 w-full rounded-card border border-outline-variant/80 p-5 pt-4 shadow-[0_12px_32px_rgb(0_0_0_/_0.55)] transition-colors duration-200 hover:border-primary/60 sm:p-6 sm:pt-5"
        >
        <!-- Punch-hole slot where the hook enters -->
        <div aria-hidden="true" class="mb-4 flex justify-center">
          <span class="h-2.5 w-12 rounded-full border border-outline-variant bg-background"></span>
        </div>

        <!-- Header: brand emblem + brand + role -->
        <div class="flex items-center gap-3.5 pb-4">
          <div
            aria-hidden="true"
            class="flex size-12 shrink-0 items-center justify-center rounded-md border border-outline-variant/60 bg-surface-container-high text-on-surface"
          >
            <BrandMark class="size-7 text-on-surface" />
          </div>
          <div class="min-w-0">
            <p class="text-label-md tracking-wider text-primary">{brand}</p>
            <p class="truncate text-title-md text-on-surface">{owner}</p>
            <p class="truncate text-body-sm text-on-surface-variant">{role}</p>
          </div>
        </div>

        <!-- Identity details -->
        {
          details.length > 0 && (
            <dl class="divide-y divide-outline-variant/50 border-t border-outline-variant/50">
              {details.map((row, idx) => (
                <div
                  class:list={[
                    'flex items-baseline justify-between gap-4',
                    idx === details.length - 1 ? 'pt-3' : 'py-3',
                  ]}
                >
                  <dt class="text-label-md text-on-surface-variant">{row.label}</dt>
                  <dd class="text-right text-body-md text-on-surface">{row.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import { triggerLanyardSakuga } from '../lib/sakuga-bridge';

  const rig = document.querySelector<HTMLElement>('[data-lanyard-rig]');
  const strap = document.querySelector<HTMLElement>('[data-lanyard-strap]');
  const payload = document.querySelector<HTMLElement>('[data-lanyard-payload]');
  const card = document.querySelector<HTMLElement>('[data-lanyard-card]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rig && payload && card && !reducedMotion) {
    let px = 0;
    let py = 0;
    let vx = 0;
    let vy = 0;
    let tiltX = 0;
    let tiltY = 0;

    let targetX = 0;
    let targetY = 0;
    let targetTiltX = 0;
    let targetTiltY = 0;

    let dragging = false;
    let startX = 0;
    let startY = 0;
    let grabOffsetX = 0;
    let grabOffsetY = 0;
    let baseStrapLen = 96;
    let maxPullY = 280;
    let hoverRect: DOMRect | null = null;
    let rafId = 0;
    let lastTime = 0;

    function clamp(value: number, min: number, max: number) {
      return Math.max(min, Math.min(max, value));
    }

    function elasticPull(delta: number, limit: number) {
      if (delta <= 0) return clamp(delta * 0.25, -18, 0);
      const linearZone = limit * 0.75;
      if (delta <= linearZone) return delta * 0.92;
      const extra = delta - linearZone;
      const headroom = limit - linearZone * 0.92;
      return linearZone * 0.92 + (headroom * extra) / (extra + headroom * 0.85);
    }

    function measureConstraints() {
      if (strap && strap.offsetHeight > 10) {
        baseStrapLen = strap.offsetHeight;
      }
      const cardRect = card!.getBoundingClientRect();
      hoverRect = cardRect;

      const projectsTarget =
        document.getElementById('projects-heading') ?? document.getElementById('projects');
      if (projectsTarget) {
        const targetRect = projectsTarget.getBoundingClientRect();
        const restingCardBottom = cardRect.bottom - py;
        const reachToProjects = Math.round(targetRect.bottom + 36 - restingCardBottom);
        maxPullY = clamp(reachToProjects, 180, 440);
      } else {
        maxPullY = 280;
      }
    }

    function setWillChange(active: boolean) {
      const value = active ? 'transform' : '';
      rig!.style.willChange = value;
      payload!.style.willChange = value;
      card!.style.willChange = value;
      if (strap) strap.style.willChange = value;
    }

    function render(now: number) {
      const dt = lastTime ? clamp((now - lastTime) / 1000, 0.004, 0.032) : 1 / 60;
      lastTime = now;

      // Time-based critically/lightly damped spring so motion feels identical across 60Hz/120Hz displays
      const k = dragging ? 260 : 185;
      const c = dragging ? 28 : 16;

      vx += ((targetX - px) * k - vx * c) * dt;
      vy += ((targetY - py) * k - vy * c) * dt;
      px += vx * dt;
      py += vy * dt;

      const tiltFactor = 1 - Math.exp(-14 * dt);
      tiltX += (targetTiltX - tiltX) * tiltFactor;
      tiltY += (targetTiltY - tiltY) * tiltFactor;

      const spanY = Math.max(24, baseStrapLen + py);
      const totalLen = Math.hypot(px, spanY);
      const stretch = totalLen / baseStrapLen;
      const extendY = totalLen - baseStrapLen;
      const pendulumDeg = -Math.atan2(px, spanY) * (180 / Math.PI);

      rig!.style.transform = `rotate(${pendulumDeg.toFixed(2)}deg)`;
      if (strap) {
        strap.style.transform = `scaleY(${stretch.toFixed(4)})`;
      }
      payload!.style.transform = `translate3d(0, ${extendY.toFixed(2)}px, 0)`;
      card!.style.transform = `perspective(900px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;

      const settled =
        !dragging &&
        Math.abs(px - targetX) < 0.25 &&
        Math.abs(py - targetY) < 0.25 &&
        Math.abs(vx) < 2 &&
        Math.abs(vy) < 2 &&
        Math.abs(tiltX - targetTiltX) < 0.05 &&
        Math.abs(tiltY - targetTiltY) < 0.05;

      if (settled) {
        px = 0;
        py = 0;
        vx = 0;
        vy = 0;
        tiltX = 0;
        tiltY = 0;
        lastTime = 0;
        rig!.style.transform = '';
        payload!.style.transform = '';
        card!.style.transform = '';
        if (strap) strap.style.transform = '';
        setWillChange(false);
        rafId = 0;
      } else {
        rafId = window.requestAnimationFrame(render);
      }
    }

    function ensureAnimating() {
      if (!rafId) {
        lastTime = 0;
        setWillChange(true);
        rafId = window.requestAnimationFrame(render);
      }
    }

    card.style.cursor = 'grab';

    card.addEventListener('pointerenter', () => {
      if (!dragging) {
        hoverRect = card.getBoundingClientRect();
        if (strap && strap.offsetHeight > 10) {
          baseStrapLen = strap.offsetHeight;
        }
      }
    });

    card.addEventListener('pointerdown', (e) => {
      measureConstraints();
      if (e.pointerType === 'touch') {
        // Elastic impulse on tap without hijacking vertical page scroll
        vy += 420;
        vx += 160;
        targetY = Math.min(56, maxPullY * 0.25);
        ensureAnimating();
        triggerLanyardSakuga(card!, 'tap', 0, 0);
        window.setTimeout(() => {
          targetY = 0;
          ensureAnimating();
        }, 160);
        return;
      }
      dragging = true;
      startX = e.clientX;
      startY = e.clientY;
      grabOffsetX = px;
      grabOffsetY = Math.max(0, py);
      card.style.cursor = 'grabbing';
      try {
        card.setPointerCapture(e.pointerId);
      } catch {
        // Ignore capture failure on synthetic or already-released pointers.
      }
      ensureAnimating();
    });

    card.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;

      if (dragging) {
        const dx = clamp(grabOffsetX + (e.clientX - startX), -200, 200);
        const dy = grabOffsetY + (e.clientY - startY);
        targetX = dx * 0.9;
        targetY = elasticPull(dy, maxPullY);
        targetTiltY = clamp(dx * 0.045, -8, 8);
        targetTiltX = clamp(-targetY * 0.03, -8, 4);
        ensureAnimating();
        return;
      }

      const rect = hoverRect ?? card.getBoundingClientRect();
      hoverRect = rect;
      const nx = (e.clientX - rect.left) / rect.width - 0.5;
      const ny = (e.clientY - rect.top) / rect.height - 0.5;
      targetX = clamp(nx * 10, -8, 8);
      targetY = 0;
      targetTiltY = clamp(nx * 8, -5, 5);
      targetTiltX = clamp(-ny * 8, -5, 5);
      ensureAnimating();
    });

    function releaseCard() {
      if (!dragging) return;
      const releaseDx = px;
      const releaseDy = py;
      dragging = false;
      hoverRect = null;
      card!.style.cursor = 'grab';
      targetX = 0;
      targetY = 0;
      targetTiltX = 0;
      targetTiltY = 0;
      ensureAnimating();
      triggerLanyardSakuga(card!, 'release', releaseDx, releaseDy);
    }

    card.addEventListener('pointerup', releaseCard);
    card.addEventListener('pointercancel', releaseCard);
    card.addEventListener('pointerleave', () => {
      if (!dragging) {
        hoverRect = null;
        targetX = 0;
        targetY = 0;
        targetTiltX = 0;
        targetTiltY = 0;
        ensureAnimating();
      }
    });
  }
</script>
