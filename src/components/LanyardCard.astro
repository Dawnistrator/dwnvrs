---
import { site } from '../config/site';

const initial = site.owner.slice(0, 1).toUpperCase();
---

<aside aria-label="Developer ID card" class="flex justify-center lg:-mt-20 lg:justify-end">
  <div class="relative flex w-full max-w-xs flex-col items-center select-none sm:max-w-sm">
    <!-- Anchor ring at the top of the lanyard (connects to the top bar on desktop) -->
    <div
      aria-hidden="true"
      class="z-10 h-2.5 w-10 rounded-full border border-outline bg-surface-container-high lg:rounded-t-none lg:border-t-0"
    ></div>

    <!-- Pivoting assembly: strap + clasp + hook + M3 card -->
    <div
      data-lanyard-rig
      class="flex w-full origin-top flex-col items-center will-change-transform"
    >
      <!-- Lanyard strap -->
      <div
        aria-hidden="true"
        data-lanyard-strap
        class="relative -mt-0.5 flex h-10 w-8 origin-top flex-col items-center justify-center overflow-hidden border-x border-outline-variant/60 bg-primary-container lg:h-24"
      >
        <span class="h-full w-1.5 bg-accent/85"></span>
      </div>

      <!-- Clasp hardware + hook pin reaching into the card slot -->
      <div
        aria-hidden="true"
        class="z-20 -mt-0.5 flex flex-col items-center"
      >
        <div class="flex h-4 w-10 items-center justify-center rounded-xs border border-outline bg-surface-container-highest">
          <span class="h-1 w-4 rounded-full bg-outline"></span>
        </div>
        <span class="h-4 w-2 rounded-b-full border border-t-0 border-outline bg-surface-container-high"></span>
      </div>

      <!-- M3 ID Card -->
      <div
        data-lanyard-card
        class="card-filled relative -mt-2.5 w-full rounded-card border border-outline-variant/80 p-5 pt-4 shadow-[0_12px_32px_rgb(0_0_0_/_0.55)] transition-colors duration-200 hover:border-primary/60 sm:p-6 sm:pt-5"
      >
        <!-- Punch-hole slot where the hook enters -->
        <div aria-hidden="true" class="mb-4 flex justify-center">
          <span class="h-2.5 w-12 rounded-full border border-outline-variant bg-background"></span>
        </div>

        <!-- Header: monogram + brand + role -->
        <div class="flex items-center gap-3.5 pb-4">
          <div
            aria-hidden="true"
            class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary-container text-title-lg font-bold text-on-primary-container"
          >
            {initial}
          </div>
          <div class="min-w-0">
            <p class="text-label-md tracking-wider text-primary">{site.brand}</p>
            <p class="truncate text-title-md text-on-surface">{site.owner}</p>
            <p class="truncate text-body-sm text-on-surface-variant">{site.role}</p>
          </div>
        </div>

        <!-- Identity details -->
        <dl class="divide-y divide-outline-variant/50 border-t border-outline-variant/50">
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-label-md text-on-surface-variant">Focus</dt>
            <dd class="text-right text-body-md text-on-surface">Apps &amp; websites</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-label-md text-on-surface-variant">Workflow</dt>
            <dd class="text-right text-body-md text-on-surface">AI-assisted</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 pt-3">
            <dt class="text-label-md text-on-surface-variant">Stack</dt>
            <dd class="text-right text-body-md text-on-surface">Astro, TS, Tailwind, Supabase</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</aside>

<script>
  const rig = document.querySelector<HTMLElement>('[data-lanyard-rig]');
  const strap = document.querySelector<HTMLElement>('[data-lanyard-strap]');
  const card = document.querySelector<HTMLElement>('[data-lanyard-card]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rig && card && !reducedMotion) {
    let angle = 0;
    let angleV = 0;
    let tiltX = 0;
    let tiltY = 0;
    let pullY = 0;
    let targetAngle = 0;
    let targetTiltX = 0;
    let targetTiltY = 0;
    let targetPullY = 0;

    let dragging = false;
    let startX = 0;
    let startY = 0;
    let rafId = 0;

    function clamp(value: number, min: number, max: number) {
      return Math.max(min, Math.min(max, value));
    }

    function render() {
      // Spring toward target values
      const stiffness = dragging ? 0.28 : 0.12;
      const damping = dragging ? 0.65 : 0.82;

      angleV = (angleV + (targetAngle - angle) * stiffness) * damping;
      angle += angleV;
      tiltX += (targetTiltX - tiltX) * 0.2;
      tiltY += (targetTiltY - tiltY) * 0.2;
      pullY += (targetPullY - pullY) * 0.2;

      rig!.style.transform = `translateY(${pullY.toFixed(2)}px) rotate(${angle.toFixed(2)}deg)`;
      card!.style.transform = `perspective(900px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg)`;
      if (strap) {
        const stretch = 1 + Math.max(0, pullY) / 180;
        strap.style.transform = `scaleY(${stretch.toFixed(3)})`;
      }

      const settled =
        !dragging &&
        Math.abs(angle - targetAngle) < 0.02 &&
        Math.abs(angleV) < 0.02 &&
        Math.abs(tiltX - targetTiltX) < 0.02 &&
        Math.abs(tiltY - targetTiltY) < 0.02 &&
        Math.abs(pullY - targetPullY) < 0.02;

      if (settled) {
        rig!.style.transform = '';
        card!.style.transform = '';
        if (strap) strap.style.transform = '';
        rafId = 0;
      } else {
        rafId = window.requestAnimationFrame(render);
      }
    }

    function ensureAnimating() {
      if (!rafId) {
        rafId = window.requestAnimationFrame(render);
      }
    }

    card.style.cursor = 'grab';

    card.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') {
        // Gentle tap swing on touch devices without hijacking vertical scroll
        angleV += 2.6;
        targetPullY = 4;
        ensureAnimating();
        window.setTimeout(() => {
          targetPullY = 0;
          ensureAnimating();
        }, 120);
        return;
      }
      dragging = true;
      startX = e.clientX;
      startY = e.clientY;
      card.style.cursor = 'grabbing';
      card.setPointerCapture(e.pointerId);
      ensureAnimating();
    });

    card.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;

      if (dragging) {
        const dx = clamp(e.clientX - startX, -140, 140);
        const dy = clamp(e.clientY - startY, -30, 80);
        targetAngle = clamp(-dx * 0.06, -9, 9);
        targetPullY = clamp(dy * 0.18, -4, 14);
        targetTiltY = clamp(dx * 0.05, -7, 7);
        targetTiltX = clamp(-dy * 0.05, -6, 6);
        ensureAnimating();
        return;
      }

      const rect = card.getBoundingClientRect();
      const nx = (e.clientX - rect.left) / rect.width - 0.5;
      const ny = (e.clientY - rect.top) / rect.height - 0.5;
      targetAngle = clamp(-nx * 3.5, -3, 3);
      targetTiltY = clamp(nx * 8, -5, 5);
      targetTiltX = clamp(-ny * 8, -5, 5);
      ensureAnimating();
    });

    function releaseCard() {
      if (!dragging) return;
      dragging = false;
      card!.style.cursor = 'grab';
      targetAngle = 0;
      targetTiltX = 0;
      targetTiltY = 0;
      targetPullY = 0;
      ensureAnimating();
    }

    card.addEventListener('pointerup', releaseCard);
    card.addEventListener('pointercancel', releaseCard);
    card.addEventListener('pointerleave', () => {
      if (!dragging) {
        targetAngle = 0;
        targetTiltX = 0;
        targetTiltY = 0;
        targetPullY = 0;
        ensureAnimating();
      }
    });
  }
</script>
