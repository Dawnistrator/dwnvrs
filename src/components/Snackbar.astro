---
interface Props {
  initialMessage?: string | null;
}

const { initialMessage = null } = Astro.props;
---

<sakuga-toast
  id="app-sakuga-toast"
  class="sakuga-toast-host"
  duration="4.5"
  data-initial-message={initialMessage ?? ''}
></sakuga-toast>
<div id="app-snackbar-sr" class="sr-only" role="status" aria-live="polite" aria-atomic="true">
  {initialMessage ?? ''}
</div>

<script>
  import { getSakugaFx } from '../lib/sakuga-bridge';

  const toastEl = document.getElementById('app-sakuga-toast') as SakugaToastElement | null;
  const srEl = document.getElementById('app-snackbar-sr');

  async function showSnackbar(message: string) {
    if (!toastEl || !message) return;
    if (srEl) srEl.textContent = message;
    if (!customElements.get('sakuga-toast')) {
      await customElements.whenDefined('sakuga-toast');
    }
    getSakugaFx();
    toastEl.show(message);
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toastEl?.open) {
      toastEl.hide();
    }
  });

  window.addEventListener('app:snackbar', ((e: CustomEvent<{ message?: string }>) => {
    if (e.detail?.message) {
      void showSnackbar(e.detail.message);
    }
  }) as EventListener);

  const initial = toastEl?.getAttribute('data-initial-message');
  if (initial) {
    void showSnackbar(initial);
  }
</script>
