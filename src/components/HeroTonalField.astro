---
/*
 * Subtle M3 tonal spotlight behind the hero section.
 * Uses only pre-feathered radial gradients moved via compositor transforms
 * (translate3d + opacity), with automatic idle settling and off-screen pause.
 */
---

<div
  aria-hidden="true"
  data-hero-tonal-field
  class="pointer-events-none absolute inset-0 -z-10 overflow-hidden select-none"
>
  <div class="hero-tonal-ambient"></div>
  <div data-hero-spotlight class="hero-tonal-spotlight"></div>
  <div class="hero-tonal-fade"></div>
</div>

<style>
  .hero-tonal-ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 62% 72% at 50% 24%,
      color-mix(in srgb, var(--md-sys-color-primary-container) 20%, transparent) 0%,
      color-mix(in srgb, var(--md-sys-color-surface-container) 36%, transparent) 44%,
      transparent 76%
    );
  }

  @media (width >= 64rem) {
    .hero-tonal-ambient {
      background: radial-gradient(
        ellipse 56% 74% at 72% 36%,
        color-mix(in srgb, var(--md-sys-color-primary-container) 22%, transparent) 0%,
        color-mix(in srgb, var(--md-sys-color-surface-container) 38%, transparent) 44%,
        transparent 76%
      );
    }
  }

  .hero-tonal-spotlight {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(22rem, 48vw, 40rem);
    aspect-ratio: 1;
    border-radius: 9999px;
    opacity: 0;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--md-sys-color-primary-container) 30%, transparent) 0%,
      color-mix(in srgb, var(--md-sys-color-surface-container-high) 26%, transparent) 38%,
      transparent 72%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tonal-spotlight {
      display: none;
    }
  }

  .hero-tonal-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 6rem;
    background: linear-gradient(to bottom, transparent, var(--md-sys-color-background));
  }
</style>

<script>
  const field = document.querySelector<HTMLElement>('[data-hero-tonal-field]');
  const spotlight = field?.querySelector<HTMLElement>('[data-hero-spotlight]') ?? null;
  const heroSection = field?.closest<HTMLElement>('section') ?? null;
  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (field && spotlight && heroSection && !reducedMotionQuery.matches) {
    let fieldWidth = 0;
    let fieldHeight = 0;
    let halfSize = 0;
    let restX = 0;
    let restY = 0;

    let currentX = 0;
    let currentY = 0;
    let currentOpacity = 0;

    let targetX = 0;
    let targetY = 0;
    let targetOpacity = 0.78;

    let isVisible = true;
    let rafId = 0;

    function clamp(value: number, min: number, max: number) {
      return Math.max(min, Math.min(max, value));
    }

    function computeMetrics() {
      const rect = field!.getBoundingClientRect();
      fieldWidth = rect.width;
      fieldHeight = rect.height;
      halfSize = spotlight!.offsetWidth / 2;

      const isDesktop = window.innerWidth >= 1024;
      const anchorX = isDesktop ? fieldWidth * 0.72 : fieldWidth * 0.5;
      const anchorY = isDesktop ? fieldHeight * 0.36 : fieldHeight * 0.28;

      restX = anchorX - halfSize;
      restY = anchorY - halfSize;
    }

    function applyTransform() {
      spotlight!.style.transform = `translate3d(${currentX.toFixed(1)}px, ${currentY.toFixed(1)}px, 0)`;
      spotlight!.style.opacity = currentOpacity.toFixed(3);
    }

    function stopLoop() {
      if (rafId) {
        window.cancelAnimationFrame(rafId);
        rafId = 0;
      }
      spotlight!.style.willChange = '';
    }

    function render() {
      if (!isVisible || document.hidden || reducedMotionQuery.matches) {
        stopLoop();
        return;
      }

      const ease = 0.1;
      currentX += (targetX - currentX) * ease;
      currentY += (targetY - currentY) * ease;
      currentOpacity += (targetOpacity - currentOpacity) * 0.08;

      applyTransform();

      const settled =
        Math.abs(targetX - currentX) < 0.35 &&
        Math.abs(targetY - currentY) < 0.35 &&
        Math.abs(targetOpacity - currentOpacity) < 0.005;

      if (settled) {
        currentX = targetX;
        currentY = targetY;
        currentOpacity = targetOpacity;
        applyTransform();
        stopLoop();
      } else {
        rafId = window.requestAnimationFrame(render);
      }
    }

    function ensureAnimating() {
      if (!isVisible || document.hidden || reducedMotionQuery.matches) return;
      if (!rafId) {
        spotlight!.style.willChange = 'transform, opacity';
        rafId = window.requestAnimationFrame(render);
      }
    }

    computeMetrics();
    // Initial one-shot settle: start slightly offset so the hero breathes into place once.
    currentX = restX + 24;
    currentY = restY - 18;
    currentOpacity = 0;
    targetX = restX;
    targetY = restY;
    targetOpacity = 0.78;
    applyTransform();
    ensureAnimating();

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => {
        const wasAtRest = Math.abs(targetX - restX) < 1 && Math.abs(targetY - restY) < 1;
        computeMetrics();
        if (wasAtRest) {
          targetX = restX;
          targetY = restY;
          currentX = restX;
          currentY = restY;
          applyTransform();
        }
      });
      resizeObserver.observe(field);
    }

    if ('IntersectionObserver' in window) {
      const intersectionObserver = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          isVisible = entry.isIntersecting;
          if (!isVisible) {
            stopLoop();
          }
        },
        { threshold: 0 },
      );
      intersectionObserver.observe(heroSection);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopLoop();
      }
    });

    reducedMotionQuery.addEventListener('change', (e) => {
      if (e.matches) {
        stopLoop();
      }
    });

    heroSection.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !isVisible) return;
      const rect = field.getBoundingClientRect();
      fieldWidth = rect.width;
      fieldHeight = rect.height;

      const px = clamp(e.clientX - rect.left, fieldWidth * 0.1, fieldWidth * 0.9);
      const py = clamp(e.clientY - rect.top, fieldHeight * 0.14, fieldHeight * 0.8);

      targetX = px - halfSize;
      targetY = py - halfSize;
      targetOpacity = 1;
      ensureAnimating();
    });

    heroSection.addEventListener('pointerleave', () => {
      targetX = restX;
      targetY = restY;
      targetOpacity = 0.78;
      ensureAnimating();
    });
  }
</script>
