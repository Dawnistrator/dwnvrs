---
import type { FavoriteCategory, FavoriteItem, FavoritesResult } from '../lib/favorites';
import type { LastFmResult } from '../lib/lastfm';
import { monogram } from '../lib/projects';
import type { SiteContent } from '../lib/site-content';
import type { SocialsResult } from '../lib/socials';
import ExpressiveBadge from './ExpressiveBadge.astro';
import Icon from './Icon.astro';

interface Props {
  mode?: 'page' | 'section';
  content: SiteContent;
  favoritesResult: FavoritesResult;
  lastFmResult: LastFmResult;
  socialsResult: SocialsResult;
  isAdmin?: boolean;
}

const {
  mode = 'page',
  content,
  favoritesResult,
  lastFmResult,
  socialsResult,
  isAdmin = false,
} = Astro.props;

const isSection = mode === 'section';
const IntroHeadingTag = isSection ? 'h3' : 'h1';
const SectionHeadingTag = isSection ? 'h3' : 'h2';
const ItemHeadingTag = isSection ? 'h4' : 'h3';
const ErrorHeadingTag = isSection ? 'h3' : 'h1';
const DialogHeadingTag = isSection ? 'h3' : 'h2';

const items = favoritesResult.status === 'error' ? [] : favoritesResult.items;
const games = items.filter((item) => item.category === 'game');
const movies = items.filter((item) => item.category === 'movie');
const music = items.filter((item) => item.category === 'music');

const hasCustomMusic = favoritesResult.status === 'ok' && music.some((item) => !item.isSample);
const lastFmRecentTracks = lastFmResult.status === 'ok' ? lastFmResult.recentTracks : [];
const useAutoLastFmList = !hasCustomMusic && lastFmResult.status === 'ok';
const effectiveMusicCount = useAutoLastFmList ? 1 + lastFmRecentTracks.length : music.length;

const spotlightMusic = useAutoLastFmList ? null : music.find((item) => item.featured) ?? music[0] ?? null;
const tracklistMusic = useAutoLastFmList
  ? []
  : spotlightMusic
    ? music.filter((item) => item.id !== spotlightMusic.id)
    : [];

const socialList = socialsResult.status === 'ok' ? socialsResult.socials : [];
function findSocialByKeywords(keywords: string[]) {
  return (
    socialList.find((s) =>
      keywords.some((kw) => s.platform.toLowerCase().includes(kw) || s.url.toLowerCase().includes(kw)),
    ) ?? null
  );
}

const youtubeSocial = findSocialByKeywords(['youtube']);
const gameSocial = findSocialByKeywords(['steam', 'backloggd', 'playstation', 'xbox', 'epic', 'hoyolab']);
const musicSocial = findSocialByKeywords(['last.fm', 'spotify', 'soundcloud', 'apple music']);
const lastFmProfileUrl =
  lastFmResult.status === 'ok'
    ? lastFmResult.track.profileUrl
    : lastFmResult.status === 'empty' || lastFmResult.status === 'error'
      ? lastFmResult.profileUrl
      : musicSocial?.url ?? 'https://www.last.fm';

const categoryLabel: Record<FavoriteCategory, string> = {
  game: 'Game',
  movie: 'YouTube',
  music: 'Music',
};

const filterOptions: { id: 'all' | FavoriteCategory; label: string; count: number }[] = [
  { id: 'all', label: 'All', count: games.length + movies.length + effectiveMusicCount },
  { id: 'game', label: 'Games', count: games.length },
  { id: 'movie', label: 'YouTube', count: movies.length },
  { id: 'music', label: 'Music', count: effectiveMusicCount },
];

function posterDataAttrs(item: FavoriteItem) {
  return {
    'data-fav-trigger': 'true',
    'data-title': item.title,
    'data-subtitle': item.subtitle,
    'data-review': item.review,
    'data-category': categoryLabel[item.category],
    'data-cover': item.cover_url ?? '',
    'data-url': item.external_url ?? '',
    'data-accent': item.accent_color || '#8c52ff',
    'data-sample': item.isSample ? 'true' : 'false',
  };
}
---

<div
  class="space-y-8"
  data-favorites-root
  data-base-games={games.length}
  data-base-movies={movies.length}
  data-base-music={music.length}
  data-has-custom-music={hasCustomMusic ? 'true' : 'false'}
>
  {
    favoritesResult.status === 'fallback' && (
      <div
        role="note"
        class="flex flex-col gap-3 rounded-lg border border-outline-variant bg-surface-container-low p-4 sm:flex-row sm:items-center sm:justify-between sm:px-5"
      >
        <p class="text-body-md text-on-surface-variant">
          {favoritesResult.reason === 'not-configured'
            ? 'Supabase is not connected yet. Showing sample placeholders for games, YouTube channels, and music.'
            : favoritesResult.reason === 'missing-table'
              ? 'Table public.favorite_items has not been created in Supabase yet. Showing sample placeholders until schema.sql is applied.'
              : 'No published favorites yet. Showing sample placeholders until you add your own games, YouTube channels, and music.'}
        </p>
        {isAdmin && (
          <a href="/admin?tab=favorites" class="btn btn-text self-start sm:self-center">
            Open admin
          </a>
        )}
      </div>
    )
  }

  {
    favoritesResult.status === 'error' ? (
      <section role="alert" class="rounded-card border border-error bg-surface-container-low p-6 space-y-3">
        <div class="flex items-center gap-2 text-title-md text-error">
          <Icon name="error" class="size-5" />
          <ErrorHeadingTag>Could not load favorites</ErrorHeadingTag>
        </div>
        <p class="text-body-md text-on-surface-variant">
          Supabase returned an error ({favoritesResult.message}). Refresh the page or check your database tables.
        </p>
        <div>
          <a href={isSection ? '/#favorites' : '/favorites'} class="btn btn-outlined">
            Try again
          </a>
        </div>
      </section>
    ) : (
      <>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-nowrap items-center gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:flex-wrap sm:gap-2 sm:overflow-visible" role="group" aria-label="Filter favorites by category" data-fav-filters>
            {filterOptions.map((option) => (
              <button
                type="button"
                class="chip-filter"
                data-fav-filter={option.id}
                aria-pressed={option.id === 'all' ? 'true' : 'false'}
              >
                <Icon name="check" class="chip-check" />
                <span>{option.label}</span>
                <span class="tabular-nums text-[11px] opacity-75 sm:text-label-md" data-fav-count={option.id}>({option.count})</span>
              </button>
            ))}
          </div>
          <p class="text-body-sm text-on-surface-variant" aria-live="polite" data-fav-live>
            Showing {games.length + movies.length + effectiveMusicCount} curated items across games, YouTube channels, and music.
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-2" data-fav-columns>
          <!-- Full-width Intro Banner -->
          <section
            aria-labelledby="favorites-intro-heading"
            data-fav-intro
            class="card-filled relative overflow-hidden rounded-xl p-5 sm:p-7 lg:col-span-2"
            style="background: radial-gradient(at 105% 115%, color-mix(in srgb, var(--md-sys-color-primary) 16%, transparent) 0%, var(--md-sys-color-surface-container) 70%);"
          >
            <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
              <div class="space-y-4">
                <ExpressiveBadge shape="clover" tone="primary" icon="bookmark" />

                <div class="space-y-3">
                  <p class="text-label-lg text-primary">
                    {content.brand} · {content.owner}
                  </p>
                  <IntroHeadingTag id="favorites-intro-heading" class="text-display-sm text-on-surface text-balance">
                    Off the clock
                  </IntroHeadingTag>
                  <ul class="list-disc space-y-1.5 pl-5 text-body-lg text-on-surface-variant text-pretty">
                    <li>video games that hooked me for dozens of hours</li>
                    <li>YouTube channels and tech creators on my daily watch list</li>
                    <li>albums and tracks on rotation while writing code</li>
                  </ul>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 pt-1 lg:shrink-0 lg:justify-end">
                <span class="chip-assist tabular-nums">{games.length} Games</span>
                <span class="chip-assist tabular-nums">{movies.length} Channels</span>
                <span class="chip-assist tabular-nums" data-fav-stat="music">{effectiveMusicCount} Tracks</span>
              </div>
            </div>
          </section>

          <div class="fav-pair grid gap-6 lg:col-span-2 lg:grid-cols-2 lg:gap-x-6 lg:gap-y-5" data-fav-pair>
          <!-- YouTube Channels -->
          <section
            aria-labelledby="channels-heading"
            data-fav-section="movie"
            class="card-filled fav-pair-card flex min-w-0 flex-col justify-between gap-5 rounded-xl p-5 sm:p-7"
          >
              <ExpressiveBadge shape="pill-tilted" tone="secondary" icon="youtube" class="self-start lg:justify-self-start" />

              <div class="min-w-0 w-full space-y-1.5 lg:self-start">
                <div class="flex items-center justify-between gap-2">
                  <SectionHeadingTag id="channels-heading" class="text-headline-sm text-on-surface text-balance">
                    What I'm watching
                  </SectionHeadingTag>
                  <span class="inline-flex shrink-0 items-center gap-1.5 rounded-xs border border-outline-variant/70 px-2 py-0.5 text-label-sm text-on-surface-variant">
                    <Icon name="youtube" class="size-3.5 text-primary" />
                    <span>YouTube</span>
                  </span>
                </div>
                <p class="text-body-md text-on-surface-variant text-pretty">
                  Channels and creators I watch regularly. Select any channel for notes and a direct link.
                </p>
              </div>

              {movies.length === 0 ? (
                <div class="min-w-0 w-full rounded-lg bg-surface-container-low p-5 text-body-md text-on-surface-variant lg:self-start">
                  No YouTube channels published yet.
                </div>
              ) : (
                <div class="flex min-w-0 w-full flex-col gap-2 lg:self-start">
                    {movies.map((channel) => (
                      <button
                        type="button"
                        aria-label={`View details for ${channel.title}`}
                        class="state-layer group flex min-h-14 w-full items-center gap-3.5 rounded-lg border border-outline-variant/40 bg-surface-container-low px-3.5 py-2.5 text-left transition-colors duration-200 ease-effects-default hover:border-outline hover:bg-surface-container-high motion-safe:transition-[background-color,border-color,transform] motion-safe:active:scale-[0.99] focus-visible:outline-3 focus-visible:outline-primary sm:px-4 sm:py-3"
                        style={`--poster-accent: ${channel.accent_color || '#ef4444'};`}
                        {...posterDataAttrs(channel)}
                      >
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border border-outline-variant/50 bg-surface-container-high">
                          {channel.cover_url ? (
                            <img
                              src={channel.cover_url}
                              alt={`${channel.title} avatar`}
                              width={96}
                              height={96}
                              loading="lazy"
                              referrerpolicy="no-referrer"
                              class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-[350ms] motion-safe:ease-spring-fast motion-safe:group-hover:scale-[1.06]"
                            />
                          ) : (
                            <div
                              aria-hidden="true"
                              class="flex h-full w-full items-center justify-center text-title-sm font-bold text-on-surface"
                              style="background: color-mix(in srgb, var(--poster-accent) 26%, var(--md-sys-color-surface-container-high));"
                            >
                              {monogram(channel.title)}
                            </div>
                          )}
                        </div>

                        <div class="min-w-0 flex-1 space-y-0.5">
                          <div class="flex flex-wrap items-center gap-2">
                            <ItemHeadingTag class="truncate text-title-md text-on-surface group-hover:text-primary">
                              {channel.title}
                            </ItemHeadingTag>
                            {channel.featured && !channel.isSample && (
                              <span class="shrink-0 rounded-xs bg-primary-container px-1.5 py-0.5 text-[10px] font-semibold leading-none text-on-primary-container">
                                Pinned
                              </span>
                            )}
                            {channel.isSample && (
                              <span class="shrink-0 rounded-xs border border-outline-variant/80 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-on-surface-variant">
                                Sample
                              </span>
                            )}
                          </div>
                          {channel.subtitle && (
                            <p class="truncate text-body-sm text-primary">{channel.subtitle}</p>
                          )}
                          {channel.review && (
                            <p class="line-clamp-1 text-body-sm text-on-surface-variant">{channel.review}</p>
                          )}
                        </div>

                        <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full text-on-surface-variant transition-colors duration-200 ease-effects-default group-hover:text-on-surface">
                          <Icon name="open-in-new" class="size-4.5" />
                        </span>
                      </button>
                    ))}
                  </div>
                )}
              {
                (youtubeSocial || isAdmin) && (
                  <div class="mt-auto flex min-w-0 w-full flex-wrap items-center justify-end gap-2 pt-1 lg:self-end">
                    {youtubeSocial && (
                      <a
                        href={youtubeSocial.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-tonal"
                      >
                        <span>{youtubeSocial.platform}</span>
                        <Icon name="open-in-new" />
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    )}
                    {isAdmin && (
                      <a href="/admin?tab=favorites&category=movie" class="btn btn-outlined">
                        <Icon name="add" />
                        <span>Add channel</span>
                      </a>
                    )}
                  </div>
                )
              }
            </section>

          <!-- Music -->
          <section
            aria-labelledby="music-heading"
            data-fav-section="music"
            class="card-filled fav-pair-card flex min-w-0 flex-col justify-between gap-5 rounded-xl p-5 sm:p-7"
          >
            <ExpressiveBadge shape="scallop" tone="secondary" icon="graphic-eq" class="self-start lg:justify-self-start" />

            <div class="min-w-0 w-full space-y-1.5 lg:self-start">
              <div class="flex items-center justify-between gap-2">
                <SectionHeadingTag id="music-heading" class="text-headline-sm text-on-surface text-balance">
                  What I'm listening to
                </SectionHeadingTag>
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-xs border border-outline-variant/70 px-2 py-0.5 text-label-sm text-on-surface-variant">
                  <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" class="size-3.5 text-primary">
                    <path d="M14.131 22.948l-1.172-3.193c0 0-1.912 2.131-4.771 2.131-2.537 0-4.333-2.203-4.333-5.729 0-4.511 2.276-6.125 4.515-6.125 3.224 0 4.245 2.089 5.125 4.772l1.161 3.667c1.161 3.561 3.365 6.421 9.713 6.421 4.548 0 7.631-1.391 7.631-5.068 0-2.968-1.697-4.511-4.844-5.244l-2.344-0.511c-1.624-0.371-2.104-1.032-2.104-2.131 0-1.249 0.985-1.984 2.604-1.984 1.767 0 2.704 0.661 2.865 2.24l3.661-0.444c-0.297-3.301-2.584-4.656-6.323-4.656-3.308 0-6.532 1.251-6.532 5.245 0 2.5 1.204 4.077 4.245 4.807l2.484 0.589c1.865 0.443 2.484 1.224 2.484 2.287 0 1.359-1.323 1.921-3.828 1.921-3.703 0-5.244-1.943-6.124-4.625l-1.204-3.667c-1.541-4.765-4.005-6.531-8.891-6.531-5.287-0.016-8.151 3.385-8.151 9.192 0 5.573 2.864 8.595 8.005 8.595 4.14 0 6.125-1.943 6.125-1.943z" />
                  </svg>
                  <span>Last.fm</span>
                </span>
              </div>
              <p class="text-body-md text-on-surface-variant text-pretty">
                Live scrobble stream and tracks on rotation.
              </p>
            </div>

            <div class="flex min-w-0 w-full flex-col gap-4 lg:self-start">
              <!-- Live Last.fm Widget -->
              <div data-lfm-widget data-lfm-status-kind={lastFmResult.status} class="flex flex-col gap-3">
                <div
                  data-lfm-live-card
                  hidden={lastFmResult.status !== 'ok'}
                  class="rounded-lg border p-4 transition-colors duration-300 ease-effects-slow"
                  style="--lfm-accent: #8c52ff; background: color-mix(in srgb, var(--lfm-accent) 18%, var(--md-sys-color-surface-container-high)); border-color: color-mix(in srgb, var(--lfm-accent) 40%, var(--md-sys-color-outline-variant));"
                >
                  <a
                    data-lfm-link
                    href={lastFmResult.status === 'ok' ? lastFmResult.track.url : 'https://www.last.fm'}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-4 rounded-sm focus-visible:outline-3 focus-visible:outline-primary"
                  >
                    <div class="relative size-20 shrink-0 overflow-hidden rounded-md bg-surface-container-lowest">
                      <img
                        data-lfm-cover
                        crossorigin="anonymous"
                        src={lastFmResult.status === 'ok' && lastFmResult.track.coverUrl ? lastFmResult.track.coverUrl : undefined}
                        alt={
                          lastFmResult.status === 'ok'
                            ? `${lastFmResult.track.title} album cover`
                            : 'Album cover'
                        }
                        width={160}
                        height={160}
                        loading="lazy"
                        class:list={[
                          'h-full w-full object-cover',
                          !(lastFmResult.status === 'ok' && lastFmResult.track.coverUrl) && 'hidden',
                        ]}
                      />
                      <div
                        data-lfm-monogram
                        aria-hidden="true"
                        class:list={[
                          'flex h-full w-full items-center justify-center bg-primary-container text-title-lg font-bold text-on-primary-container',
                          lastFmResult.status === 'ok' && lastFmResult.track.coverUrl && 'hidden',
                        ]}
                      >
                        {lastFmResult.status === 'ok' ? monogram(lastFmResult.track.title) : 'FM'}
                      </div>
                    </div>

                    <div class="min-w-0 flex-1 space-y-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <span
                          data-lfm-eq
                          data-playing={lastFmResult.status === 'ok' && lastFmResult.track.nowPlaying && !lastFmResult.stale ? 'true' : 'false'}
                          class="eq-bars"
                          aria-hidden="true"
                        >
                          <span />
                          <span />
                          <span />
                        </span>
                        <span data-lfm-status class="text-label-sm text-primary">
                          {lastFmResult.status === 'ok' ? lastFmResult.track.relativeTime : 'Last.fm'}
                        </span>
                        <span
                          data-lfm-user
                          class="rounded-xs border border-outline-variant px-1.5 py-0.5 text-[10px] font-semibold leading-none text-on-surface-variant"
                        >
                          @{lastFmResult.status === 'ok' ? lastFmResult.track.username : ''}
                        </span>
                      </div>
                      <ItemHeadingTag data-lfm-title class="truncate text-title-lg text-on-surface group-hover:text-primary">
                        {lastFmResult.status === 'ok' ? lastFmResult.track.title : 'Recent track'}
                      </ItemHeadingTag>
                      <p data-lfm-subtitle class="truncate text-body-sm text-on-surface-variant">
                        {lastFmResult.status === 'ok'
                          ? lastFmResult.track.album
                            ? `${lastFmResult.track.artist} · ${lastFmResult.track.album}`
                            : lastFmResult.track.artist
                          : ''}
                      </p>
                    </div>

                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-on-surface-variant">
                      <Icon name="open-in-new" class="size-5" />
                    </span>
                    <span class="sr-only">(opens Last.fm track page in a new tab)</span>
                  </a>
                </div>

                <div
                  data-lfm-empty
                  hidden={lastFmResult.status !== 'empty'}
                  class="rounded-lg border border-outline-variant/50 bg-surface-container-low p-4 text-body-sm text-on-surface-variant"
                >
                  {lastFmResult.status === 'empty'
                    ? `Connected to Last.fm (@${lastFmResult.username}), but no recent scrobbles were found yet.`
                    : 'No recent Last.fm scrobbles found yet.'}
                </div>

                <div
                  data-lfm-error
                  role="alert"
                  hidden={lastFmResult.status !== 'error'}
                  class="flex flex-col gap-3 rounded-lg border border-error/70 bg-surface-container-low p-4 sm:flex-row sm:items-center sm:justify-between"
                >
                  <div class="flex min-w-0 items-start gap-2.5">
                    <Icon name="error" class="mt-0.5 size-5 shrink-0 text-error" />
                    <div class="min-w-0 space-y-0.5">
                      <p class="text-label-lg text-error">Last.fm activity unavailable</p>
                      <p data-lfm-error-text class="text-body-sm text-on-surface-variant text-pretty">
                        {lastFmResult.status === 'error' ? lastFmResult.message : 'Check your Last.fm connection.'}
                      </p>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="btn btn-outlined self-start shrink-0 sm:self-center"
                    data-lfm-retry
                    data-idle-label="Retry"
                  >
                    Retry
                  </button>
                </div>
              </div>

              <div
                data-music-empty-state
                hidden={!(music.length === 0 && lastFmResult.status === 'not-configured')}
                class="rounded-lg bg-surface-container-low p-5 text-body-md text-on-surface-variant"
              >
                No music tracks or albums published yet.
              </div>

              <div
                data-lfm-recent-list
                hidden={lastFmRecentTracks.length === 0}
                class="flex flex-col gap-0.5 overflow-hidden rounded-lg"
              >
                {lastFmRecentTracks.map((recent) => (
                  <button
                    type="button"
                    aria-label={`View details for ${recent.title}`}
                    class="state-layer group flex min-h-14 w-full items-center gap-3.5 rounded-xs bg-surface-container-low px-3.5 py-3 text-left transition-colors duration-200 ease-effects-default hover:bg-surface-container-high"
                    data-fav-trigger="true"
                    data-title={recent.title}
                    data-subtitle={recent.album ? `${recent.artist} · ${recent.album}` : recent.artist}
                    data-review={`Scrobbled via Last.fm (@${recent.username}) · ${recent.relativeTime}.`}
                    data-category="Recent scrobble"
                    data-cover={recent.coverUrl ?? ''}
                    data-url={recent.url}
                    data-accent="#8c52ff"
                    data-sample="false"
                  >
                    <div class="size-11 shrink-0 overflow-hidden rounded-sm bg-surface-container-high">
                      <img
                        data-recent-cover
                        src={recent.coverUrl || undefined}
                        alt={recent.coverUrl ? `${recent.title} cover art` : ''}
                        width={88}
                        height={88}
                        loading="lazy"
                        class:list={['h-full w-full object-cover', !recent.coverUrl && 'hidden']}
                      />
                      <div
                        data-recent-monogram
                        aria-hidden="true"
                        class:list={[
                          'flex h-full w-full items-center justify-center bg-secondary-container text-label-lg font-bold text-on-secondary-container',
                          recent.coverUrl && 'hidden',
                        ]}
                      >
                        {monogram(recent.title)}
                      </div>
                    </div>

                    <div class="min-w-0 flex-1 space-y-0.5">
                      <div class="flex items-center justify-between gap-2">
                        <span data-recent-title class="truncate text-title-md text-on-surface group-hover:text-primary">
                          {recent.title}
                        </span>
                        <span data-recent-time class="shrink-0 text-label-sm tabular-nums text-on-surface-variant">
                          {recent.relativeTime}
                        </span>
                      </div>
                      <p data-recent-subtitle class="truncate text-body-sm text-on-surface-variant">
                        {recent.album ? `${recent.artist} · ${recent.album}` : recent.artist}
                      </p>
                    </div>

                    <span class="inline-flex size-9 shrink-0 items-center justify-center text-on-surface-variant">
                      <Icon name="open-in-new" class="size-4.5" />
                    </span>
