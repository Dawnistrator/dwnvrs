<style>
  @media (width >= 64rem) {
    /* Subgrid aligns badge, header, content start, and footer CTA across side-by-side cards. */
    .fav-pair {
      grid-template-rows: auto auto 1fr auto;
    }

    .fav-pair-card {
      grid-row: span 4 / span 4;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
      grid-template-rows: subgrid;
      row-gap: 1.25rem;
    }
  }

  .eq-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .eq-bars > span {
    width: 3px;
    border-radius: 9999px;
    background: var(--md-sys-color-primary);
    height: 60%;
  }

  .eq-bars > span:nth-child(2) {
    height: 100%;
  }

  .eq-bars > span:nth-child(3) {
    height: 45%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .eq-bars:not([data-playing='false']) > span {
      transform-origin: bottom center;
      animation: eq-bounce 1.1s var(--md-sys-motion-spring-default-spatial) infinite alternate;
    }
    .eq-bars:not([data-playing='false']) > span:nth-child(2) {
      animation-delay: 0.25s;
    }
    .eq-bars:not([data-playing='false']) > span:nth-child(3) {
      animation-delay: 0.5s;
    }
  }

  @keyframes eq-bounce {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>

<script>
  /* ---------- Category Filtering ---------- */
  const favRoot = document.querySelector<HTMLElement>('[data-favorites-root]');
  const filterGroup = favRoot?.querySelector<HTMLElement>('[data-fav-filters]');
  const filterButtons = Array.from(filterGroup?.querySelectorAll<HTMLButtonElement>('[data-fav-filter]') ?? []);
  const sections = Array.from(favRoot?.querySelectorAll<HTMLElement>('[data-fav-section]') ?? []);
  const pairContainer = favRoot?.querySelector<HTMLElement>('[data-fav-pair]');
  const introSection = favRoot?.querySelector<HTMLElement>('[data-fav-intro]');
  const liveStatus = favRoot?.querySelector<HTMLElement>('[data-fav-live]');

  function applyCategoryFilter(filter: string) {
    for (const btn of filterButtons) {
      btn.setAttribute('aria-pressed', btn.dataset.favFilter === filter ? 'true' : 'false');
    }

    if (introSection) {
      introSection.hidden = filter !== 'all';
    }

    if (pairContainer) {
      pairContainer.hidden = filter === 'game';
    }

    for (const section of sections) {
      const cat = section.dataset.favSection;
      section.hidden = filter !== 'all' && cat !== filter;
      if (cat && cat !== 'game') {
        section.classList.toggle('lg:col-span-2', filter === cat);
      }
    }

    if (liveStatus) {
      const labelMap: Record<string, string> = {
        all: 'Showing all sections: games, YouTube channels, and music.',
        game: 'Filtered to Games.',
        movie: 'Filtered to YouTube channels.',
        music: 'Filtered to Music.',
      };
      liveStatus.textContent = labelMap[filter] ?? 'Showing favorites.';
    }
  }

  filterGroup?.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-fav-filter]') : null;
    if (btn?.dataset.favFilter) {
      applyCategoryFilter(btn.dataset.favFilter);
    }
  });

  /* ---------- Rich Detail Dialog ---------- */
  const dialog = document.getElementById('favorite-detail-dialog') as HTMLDialogElement | null;
  const dialogBanner = dialog?.querySelector<HTMLElement>('[data-dialog-fav-banner]');
  const dialogCover = dialog?.querySelector<HTMLImageElement>('[data-dialog-fav-cover]');
  const dialogMonogram = dialog?.querySelector<HTMLElement>('[data-dialog-fav-monogram]');
  const dialogCategory = dialog?.querySelector<HTMLElement>('[data-dialog-fav-category]');
  const dialogSample = dialog?.querySelector<HTMLElement>('[data-dialog-fav-sample]');
  const dialogSubtitle = dialog?.querySelector<HTMLElement>('[data-dialog-fav-subtitle]');
  const dialogTitle = dialog?.querySelector<HTMLElement>('[data-dialog-fav-title]');
  const dialogReview = dialog?.querySelector<HTMLElement>('[data-dialog-fav-review]');
  const dialogLink = dialog?.querySelector<HTMLAnchorElement>('[data-dialog-fav-link]');
  const dialogLinkLabel = dialog?.querySelector<HTMLElement>('[data-dialog-fav-link-label]');
  const dialogCloseBtn = dialog?.querySelector<HTMLButtonElement>('[data-dialog-fav-close]');
  let lastTrigger: HTMLElement | null = null;

  function toMonogram(title: string): string {
    const words = title.replace(/[^\p{L}\p{N}\s]/gu, '').trim().split(/\s+/).filter(Boolean);
    const letters = words.length > 1 ? `${words[0]![0]}${words[1]![0]}` : (words[0] ?? '?').slice(0, 2);
    return letters.toUpperCase();
  }

  function openFavoriteDialog(trigger: HTMLElement) {
    if (!dialog) return;
    lastTrigger = trigger;

    const title = trigger.dataset.title ?? 'Favorite item';
    const subtitle = trigger.dataset.subtitle ?? '';
    const review = trigger.dataset.review ?? '';
    const category = trigger.dataset.category ?? 'Favorite';
    const cover = trigger.dataset.cover ?? '';
    const url = trigger.dataset.url ?? '';
    const rawAccent = trigger.dataset.accent ?? '#8c52ff';
    const accent = /^#[0-9a-fA-F]{6}$/.test(rawAccent) ? rawAccent : '#8c52ff';
    const isSample = trigger.dataset.sample === 'true';
    const isChannel = category === 'YouTube';

    if (dialogBanner) {
      dialogBanner.style.background = `linear-gradient(125deg, color-mix(in srgb, ${accent} 32%, var(--md-sys-color-surface-container)) 0%, var(--md-sys-color-surface-container-low) 100%)`;
    }

    if (dialogCover && dialogMonogram) {
      dialogCover.classList.toggle('rounded-full', isChannel);
      dialogCover.classList.toggle('rounded-sm', !isChannel);
      dialogMonogram.classList.toggle('rounded-full', isChannel);
      dialogMonogram.classList.toggle('rounded-sm', !isChannel);

      if (cover) {
        dialogCover.src = cover;
        dialogCover.alt = isChannel ? `${title} avatar` : `${title} cover`;
        dialogCover.classList.remove('hidden');
        dialogMonogram.classList.add('hidden');
      } else {
        dialogCover.removeAttribute('src');
        dialogCover.alt = '';
        dialogCover.classList.add('hidden');
        dialogMonogram.textContent = toMonogram(title);
        dialogMonogram.classList.remove('hidden');
      }
    }

    if (dialogCategory) dialogCategory.textContent = category;
    if (dialogSample) dialogSample.hidden = !isSample;
    if (dialogSubtitle) {
      dialogSubtitle.textContent = subtitle;
      dialogSubtitle.hidden = !subtitle;
    }
    if (dialogTitle) dialogTitle.textContent = title;
    if (dialogReview) {
      dialogReview.textContent = review || 'No personal notes added for this item yet.';
    }
    if (dialogLink) {
      if (dialogLinkLabel) {
        dialogLinkLabel.textContent = isChannel ? 'Open YouTube channel' : 'Open link';
      }
      if (/^https?:\/\//i.test(url)) {
        dialogLink.href = url;
        dialogLink.hidden = false;
      } else {
        dialogLink.href = '#';
        dialogLink.hidden = true;
      }
    }

    dialog.showModal();
    dialogCloseBtn?.focus();
  }

  favRoot?.addEventListener('click', (e) => {
    const trigger = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-fav-trigger]') : null;
    if (trigger && favRoot.contains(trigger)) {
      openFavoriteDialog(trigger);
    }
  });

  dialogCloseBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      dialog.close();
    }
  });

  dialog?.addEventListener('close', () => {
    if (lastTrigger && document.contains(lastTrigger)) {
      lastTrigger.focus();
    }
    lastTrigger = null;
  });

  /* ---------- Live Last.fm Scrobble Polling ---------- */
  const baseGamesCount = Number.parseInt(favRoot?.dataset.baseGames ?? '0', 10) || 0;
  const baseMoviesCount = Number.parseInt(favRoot?.dataset.baseMovies ?? '0', 10) || 0;
  const baseMusicCount = Number.parseInt(favRoot?.dataset.baseMusic ?? '0', 10) || 0;
  const hasCustomMusic = favRoot?.dataset.hasCustomMusic === 'true';
  const allCountEl = favRoot?.querySelector<HTMLElement>('[data-fav-count="all"]');
  const musicCountEl = favRoot?.querySelector<HTMLElement>('[data-fav-count="music"]');
  const musicStatEl = favRoot?.querySelector<HTMLElement>('[data-fav-stat="music"]');

  const lfmWidget = favRoot?.querySelector<HTMLElement>('[data-lfm-widget]');
  const lfmLiveCard = lfmWidget?.querySelector<HTMLElement>('[data-lfm-live-card]');
  const lfmEmpty = lfmWidget?.querySelector<HTMLElement>('[data-lfm-empty]');
  const lfmError = lfmWidget?.querySelector<HTMLElement>('[data-lfm-error]');
  const lfmErrorText = lfmWidget?.querySelector<HTMLElement>('[data-lfm-error-text]');
  const lfmSetup = favRoot?.querySelector<HTMLElement>('[data-lfm-setup]');
  const musicEmptyState = favRoot?.querySelector<HTMLElement>('[data-music-empty-state]');
  const lfmStatusMsg = favRoot?.querySelector<HTMLElement>('[data-lfm-status-msg]');
  const lfmProfileLink = favRoot?.querySelector<HTMLAnchorElement>('[data-lfm-profile-link]');
  const recentRowTemplate = document.querySelector<HTMLTemplateElement>('[data-lfm-recent-row-template]');

  const lfmLink = lfmWidget?.querySelector<HTMLAnchorElement>('[data-lfm-link]');
  const lfmCover = lfmWidget?.querySelector<HTMLImageElement>('[data-lfm-cover]');
  const lfmMonogram = lfmWidget?.querySelector<HTMLElement>('[data-lfm-monogram]');
  const lfmEq = lfmWidget?.querySelector<HTMLElement>('[data-lfm-eq]');
  const lfmStatusLabel = lfmWidget?.querySelector<HTMLElement>('[data-lfm-status]');
  const lfmUser = lfmWidget?.querySelector<HTMLElement>('[data-lfm-user]');
  const lfmTitle = lfmWidget?.querySelector<HTMLElement>('[data-lfm-title]');
  const lfmSubtitle = lfmWidget?.querySelector<HTMLElement>('[data-lfm-subtitle]');

  type ClientLastFmTrack = {
    title: string;
    artist: string;
    album: string;
    url: string;
    coverUrl: string | null;
    nowPlaying: boolean;
    relativeTime: string;
    username: string;
    profileUrl?: string;
  };

  type ClientLastFmResponse =
    | {
        status: 'ok';
        stale?: boolean;
        track: ClientLastFmTrack;
        recentTracks?: ClientLastFmTrack[];
      }
    | { status: 'empty'; username: string; profileUrl?: string }
    | { status: 'not-configured' }
    | { status: 'error'; message: string; profileUrl?: string; retryable?: boolean };

  const lfmRecentList = favRoot?.querySelector<HTMLElement>('[data-lfm-recent-list]');
  let hasLoadedOk = lfmWidget?.dataset.lfmStatusKind === 'ok';

  function safeHttpUrl(raw: string | null | undefined): string {
    return raw && /^https?:\/\//i.test(raw) ? raw : '';
  }

  function extractVibrantHex(img: HTMLImageElement): string | null {
    try {
      const canvas = document.createElement('canvas');
      canvas.width = 16;
      canvas.height = 16;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx || !img.naturalWidth) return null;
      ctx.drawImage(img, 0, 0, 16, 16);
      const { data } = ctx.getImageData(0, 0, 16, 16);

      let bestScore = -1;
      let bestRgb: [number, number, number] | null = null;
      for (let i = 0; i < data.length; i += 4) {
        const r = data[i]!;
        const g = data[i + 1]!;
        const b = data[i + 2]!;
        const a = data[i + 3]!;
        if (a < 180) continue;
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        const luma = (max + min) / 510;
        const sat = max === 0 ? 0 : (max - min) / max;
        if (luma < 0.14 || luma > 0.88) continue;
        const score = sat * (1 - Math.abs(luma - 0.52));
        if (score > bestScore) {
          bestScore = score;
          bestRgb = [r, g, b];
        }
      }

      if (!bestRgb) return null;
      return `#${bestRgb.map((v) => v.toString(16).padStart(2, '0')).join('')}`;
    } catch {
      return null;
    }
  }

  function applyCoverPalette(img: HTMLImageElement | null) {
    if (!img || !lfmLiveCard) return;
    if (!img.complete || !img.naturalWidth || img.classList.contains('hidden')) {
      lfmLiveCard.style.setProperty('--lfm-accent', '#8c52ff');
      return;
    }
    const vibrant = extractVibrantHex(img);
    lfmLiveCard.style.setProperty('--lfm-accent', vibrant ?? '#8c52ff');
  }

  if (lfmCover) {
    lfmCover.addEventListener('load', () => applyCoverPalette(lfmCover));
    if (lfmCover.complete && lfmCover.naturalWidth > 0) {
      applyCoverPalette(lfmCover);
    }
  }

  function populateRecentTrackRow(btn: HTMLButtonElement, item: ClientLastFmTrack) {
    const subtitle = item.album ? `${item.artist} · ${item.album}` : item.artist;
    const safeUrl = safeHttpUrl(item.url) || 'https://www.last.fm';
    const safeCover = safeHttpUrl(item.coverUrl);

    btn.setAttribute('aria-label', `View details for ${item.title}`);
    btn.dataset.title = item.title;
    btn.dataset.subtitle = subtitle;
    btn.dataset.review = `Scrobbled via Last.fm (@${item.username}) · ${item.relativeTime}.`;
    btn.dataset.cover = safeCover;
    btn.dataset.url = safeUrl;

    const titleSpan = btn.querySelector<HTMLElement>('[data-recent-title]');
    if (titleSpan) titleSpan.textContent = item.title;
    const timeSpan = btn.querySelector<HTMLElement>('[data-recent-time]');
    if (timeSpan) timeSpan.textContent = item.relativeTime;
    const subEl = btn.querySelector<HTMLElement>('[data-recent-subtitle]');
    if (subEl) subEl.textContent = subtitle;

    const img = btn.querySelector<HTMLImageElement>('[data-recent-cover]');
    const mono = btn.querySelector<HTMLElement>('[data-recent-monogram]');
    if (img && mono) {
      if (safeCover) {
        img.src = safeCover;
        img.alt = `${item.title} cover art`;
        img.classList.remove('hidden');
        mono.classList.add('hidden');
      } else {
        img.removeAttribute('src');
        img.alt = '';
        img.classList.add('hidden');
        mono.textContent = toMonogram(item.title);
        mono.classList.remove('hidden');
      }
    }
  }

  function syncRecentTracksList(tracks: ClientLastFmTrack[]) {
    if (!lfmRecentList) return;
    const capped = tracks.slice(0, 4);
    const rows = Array.from(lfmRecentList.querySelectorAll<HTMLButtonElement>('[data-fav-trigger]'));

    if (capped.length === 0) {
      for (const row of rows) row.remove();
      lfmRecentList.hidden = true;
      return;
    }

    while (rows.length < capped.length && recentRowTemplate) {
      const fragment = recentRowTemplate.content.cloneNode(true) as DocumentFragment;
      const cloned = fragment.querySelector<HTMLButtonElement>('[data-fav-trigger]');
      if (!cloned) break;
      lfmRecentList.appendChild(cloned);
      rows.push(cloned);
    }

    while (rows.length > capped.length) {
      rows.pop()?.remove();
    }

    capped.forEach((item, idx) => {
      const btn = rows[idx];
      if (btn) populateRecentTrackRow(btn, item);
    });
    lfmRecentList.hidden = false;
  }

  function updateMusicCounts(payload: ClientLastFmResponse) {
    if (hasCustomMusic) return;
    const effectiveMusicCount =
      payload.status === 'ok'
        ? 1 + Math.min(4, Array.isArray(payload.recentTracks) ? payload.recentTracks.length : 0)
        : baseMusicCount;

    if (musicCountEl) musicCountEl.textContent = `(${effectiveMusicCount})`;
    if (allCountEl) allCountEl.textContent = `(${baseGamesCount + baseMoviesCount + effectiveMusicCount})`;
    if (musicStatEl) musicStatEl.textContent = `${effectiveMusicCount} Tracks`;
  }

  function renderLastFmState(payload: ClientLastFmResponse, manual = false) {
    if (!lfmWidget) return;
    if (payload.status === 'error' && hasLoadedOk && !manual) {
      return;
    }

    hasLoadedOk = payload.status === 'ok';
    lfmWidget.dataset.lfmStatusKind = payload.status;

    if (lfmLiveCard) lfmLiveCard.hidden = payload.status !== 'ok';
    if (lfmEmpty) lfmEmpty.hidden = payload.status !== 'empty';
    if (lfmError) lfmError.hidden = payload.status !== 'error';
    if (lfmSetup) lfmSetup.hidden = payload.status !== 'not-configured';
    if (musicEmptyState) {
      musicEmptyState.hidden = !(baseMusicCount === 0 && payload.status === 'not-configured');
    }

    if (lfmProfileLink && 'profileUrl' in payload) {
      const safeProfileUrl = safeHttpUrl(payload.profileUrl);
      if (safeProfileUrl) lfmProfileLink.href = safeProfileUrl;
    }

    if (payload.status === 'ok') {
      const t = payload.track;
      const safeTrackUrl = safeHttpUrl(t.url) || 'https://www.last.fm';
      const safeProfileUrl = safeHttpUrl(t.profileUrl);
      const safeCoverUrl = safeHttpUrl(t.coverUrl);

      if (lfmProfileLink && safeProfileUrl) lfmProfileLink.href = safeProfileUrl;
      if (lfmLink) lfmLink.href = safeTrackUrl;
      if (lfmTitle) lfmTitle.textContent = t.title;
      if (lfmSubtitle) lfmSubtitle.textContent = t.album ? `${t.artist} · ${t.album}` : t.artist;
      if (lfmStatusLabel) lfmStatusLabel.textContent = t.relativeTime;
      if (lfmUser) lfmUser.textContent = `@${t.username}`;
      if (lfmEq) lfmEq.dataset.playing = t.nowPlaying && !payload.stale ? 'true' : 'false';

      if (lfmCover && lfmMonogram) {
        if (safeCoverUrl) {
          lfmCover.src = safeCoverUrl;
          lfmCover.alt = `${t.title} album cover`;
          lfmCover.classList.remove('hidden');
          lfmMonogram.classList.add('hidden');
          if (lfmCover.complete && lfmCover.naturalWidth > 0) applyCoverPalette(lfmCover);
        } else {
          lfmCover.removeAttribute('src');
          lfmCover.classList.add('hidden');
          lfmMonogram.textContent = toMonogram(t.title);
          lfmMonogram.classList.remove('hidden');
          if (lfmLiveCard) lfmLiveCard.style.setProperty('--lfm-accent', '#8c52ff');
        }
      }

      syncRecentTracksList(Array.isArray(payload.recentTracks) ? payload.recentTracks : []);
    } else {
      if (payload.status === 'empty' && lfmEmpty) {
        lfmEmpty.textContent = `Connected to Last.fm (@${payload.username}), but no recent scrobbles were found yet.`;
      } else if (payload.status === 'error' && lfmErrorText) {
        lfmErrorText.textContent = payload.message;
      }
      syncRecentTracksList([]);
    }

    updateMusicCounts(payload);
    window.dispatchEvent(new CustomEvent('app:lastfm', { detail: payload }));
  }

  function announceLastFmStatus(msg: string) {
    if (lfmStatusMsg) {
      lfmStatusMsg.textContent = '';
      window.requestAnimationFrame(() => {
        if (lfmStatusMsg) lfmStatusMsg.textContent = msg;
      });
    }
    window.dispatchEvent(new CustomEvent('app:snackbar', { detail: { message: msg } }));
  }

  let lfmInFlight = false;
  async function refreshLastFm(manual = false) {
    if (!lfmWidget || lfmInFlight) return;
    if (!manual && lfmWidget.dataset.lfmStatusKind === 'not-configured') return;
    lfmInFlight = true;

    const retryButtons = Array.from(favRoot?.querySelectorAll<HTMLButtonElement>('[data-lfm-retry]') ?? []);
    if (manual) {
      for (const btn of retryButtons) {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = btn.dataset.idleLabel === 'Check connection' ? 'Checking...' : 'Retrying...';
      }
    }

    try {
      const res = await fetch(`/api/now-playing.json${manual ? '?refresh=1' : ''}`, {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const payload = (await res.json()) as ClientLastFmResponse;
      renderLastFmState(payload, manual);

      if (manual) {
        const msg =
          payload.status === 'ok'
            ? payload.stale
              ? 'Last.fm is temporarily unavailable. Showing your last synced track.'
              : `Updated from Last.fm: ${payload.track.title} by ${payload.track.artist}.`
            : payload.status === 'not-configured'
              ? 'Last.fm is not configured yet. Add LASTFM_USERNAME and LASTFM_API_KEY in .env.'
              : payload.status === 'empty'
                ? 'Last.fm connected, no recent scrobbles yet.'
                : payload.message;
        announceLastFmStatus(msg);
      }
    } catch {
      if (manual) {
        announceLastFmStatus('Could not check Last.fm status right now.');
      }
    } finally {
      lfmInFlight = false;
      for (const btn of retryButtons) {
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        if (btn.dataset.idleLabel) {
          btn.textContent = btn.dataset.idleLabel;
        }
      }
    }
  }

  for (const btn of favRoot?.querySelectorAll<HTMLButtonElement>('[data-lfm-retry]') ?? []) {
    btn.addEventListener('click', () => refreshLastFm(true));
  }

  if (lfmWidget && lfmWidget.dataset.lfmStatusKind !== 'not-configured') {
    window.setInterval(() => {
      if (document.visibilityState === 'visible') {
        refreshLastFm(false);
      }
    }, 20_000);

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        refreshLastFm(false);
      }
    });
  }
</script>