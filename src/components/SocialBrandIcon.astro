---
export type BrandKey =
  | 'github'
  | 'x'
  | 'instagram'
  | 'linkedin'
  | 'youtube'
  | 'tiktok'
  | 'discord'
  | 'threads'
  | 'email';

export interface BrandMeta {
  key: BrandKey;
  label: string;
}

export const SOCIAL_BRAND_PRESETS: BrandMeta[] = [
  { key: 'github', label: 'GitHub' },
  { key: 'x', label: 'X / Twitter' },
  { key: 'instagram', label: 'Instagram' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'youtube', label: 'YouTube' },
  { key: 'tiktok', label: 'TikTok' },
  { key: 'discord', label: 'Discord' },
  { key: 'threads', label: 'Threads' },
  { key: 'email', label: 'Email' },
];

export function matchSocialBrand(platform: string, url = ''): BrandKey | null {
  const p = platform.trim().toLowerCase();
  const u = url.trim().toLowerCase();
  if (p.includes('github') || u.includes('github.com')) return 'github';
  if (p === 'x' || p.includes('x / twitter') || p.includes('twitter') || u.includes('x.com') || u.includes('twitter.com')) {
    return 'x';
  }
  if (p.includes('instagram') || p === 'ig' || u.includes('instagram.com')) return 'instagram';
  if (p.includes('linkedin') || u.includes('linkedin.com')) return 'linkedin';
  if (p.includes('youtube') || p === 'yt' || u.includes('youtube.com') || u.includes('youtu.be')) return 'youtube';
  if (p.includes('tiktok') || u.includes('tiktok.com')) return 'tiktok';
  if (p.includes('discord') || u.includes('discord.gg') || u.includes('discord.com')) return 'discord';
  if (p.includes('threads') || u.includes('threads.net') || u.includes('threads.com')) return 'threads';
  if (p.includes('email') || p.includes('mail') || p.includes('gmail') || u.startsWith('mailto:')) return 'email';
  return null;
}

interface Props {
  platform: string;
  url?: string;
  class?: string;
}

const { platform, url = '', class: className } = Astro.props;
const brand = matchSocialBrand(platform, url);

