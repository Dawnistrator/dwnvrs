---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  active?: 'home' | 'projects' | 'about' | 'favorites' | 'socials';
}

const { active = 'home' } = Astro.props;

const items: { id: 'home' | 'projects' | 'about' | 'favorites' | 'socials'; label: string; href: string; icon: IconName }[] = [
  { id: 'home', label: 'Home', href: '/#top', icon: 'home' },
  { id: 'projects', label: 'Projects', href: '/#projects', icon: 'folder' },
  { id: 'about', label: 'About', href: '/#about', icon: 'person' },
  { id: 'socials', label: 'Socials', href: '/#socials', icon: 'link' },
  { id: 'favorites', label: 'Favorites', href: '/#favorites', icon: 'bookmark' },
];
---

<nav
  aria-label="Mobile navigation"
  data-mobile-nav
  class="fixed inset-x-0 bottom-0 z-30 border-t border-outline-variant/50 bg-surface-container pb-[env(safe-area-inset-bottom,0px)] md:hidden"
>
  <ul class="grid grid-cols-5">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            data-nav-id={item.id}
            aria-current={active === item.id ? 'page' : undefined}
            class="group flex min-h-16 flex-col items-center justify-center gap-1 px-1 py-2 text-label-sm sm:text-label-md text-on-surface-variant"
          >
            <span class="state-layer flex h-8 w-12 items-center justify-center rounded-full transition-colors group-aria-[current=page]:bg-secondary-container group-aria-[current=page]:text-on-secondary-container">
              <Icon name={item.icon} class="size-5" />
            </span>
            <span class="truncate group-aria-[current=page]:text-on-surface">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
