---
import { site } from '../config/site';
import type { ProjectsResult } from '../lib/projects';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  result: ProjectsResult;
  heading?: string;
  subtitle?: string;
  showAdmin?: boolean;
}

const {
  result,
  heading = site.projectsSection.heading,
  subtitle = site.projectsSection.subtitle,
  showAdmin = false,
} = Astro.props;
const categories = result.status === 'error' ? [] : ['All', ...new Set(result.projects.map((p) => p.category))];
const remainingCount = Math.max(0, result.projects.length - 1);
const gridColumns =
  remainingCount === 0
    ? 'grid-cols-1'
    : remainingCount === 1 || remainingCount === 2 || remainingCount === 4
      ? 'grid-cols-1 md:grid-cols-2'
      : 'grid-cols-1 md:grid-cols-2 xl:grid-cols-3';
---

<section id="projects" aria-labelledby="projects-heading" class="py-12 sm:py-16 lg:py-20">
  <div class="container-page space-y-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl space-y-2">
        <h2 id="projects-heading" class="text-headline-sm text-on-surface sm:text-headline-md">
          {heading}
        </h2>
        {subtitle && <p class="text-body-lg text-on-surface-variant">{subtitle}</p>}
      </div>

      {
        categories.length > 1 && (
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by category" data-project-filters>
            {categories.map((category) => (
              <button
                type="button"
                class="chip-filter"
                data-filter={category}
                aria-pressed={category === 'All' ? 'true' : 'false'}
              >
                <Icon name="check" class="chip-check" />
                <span>{category}</span>
              </button>
            ))}
          </div>
        )
      }
    </div>

    {
      result.status === 'fallback' && (
        <div
          role="note"
          class="flex flex-col gap-3 rounded-lg border border-outline-variant bg-surface-container-low p-4 sm:flex-row sm:items-center sm:justify-between sm:px-5"
        >
          <p class="text-body-md text-on-surface-variant">
            {result.reason === 'not-configured'
              ? 'Supabase is not connected yet. Showing built-in placeholder entries until environment keys are configured.'
              : 'No projects are published in Supabase yet. Showing built-in placeholder entries until you publish your first project.'}
          </p>
          {
            showAdmin && (
              <a href="/admin" class="btn btn-text self-start sm:self-center">
                Open admin
              </a>
            )
          }
        </div>
      )
    }

    {
      result.status === 'error' ? (
        <div role="alert" class="rounded-card border border-error bg-surface-container-low p-6 space-y-3">
          <div class="flex items-center gap-2 text-title-md text-error">
            <Icon name="error" class="size-5" />
            <span>Could not load projects</span>
          </div>
          <p class="text-body-md text-on-surface-variant">
            Supabase returned an error while loading projects ({result.message}). Refresh the page or check your project database settings.
          </p>
          <div>
            <a href="/#projects" class="btn btn-outlined">
              Try again
            </a>
          </div>
        </div>
      ) : (
        <>
          <p class="sr-only" aria-live="polite" data-filter-live>
            Showing all {result.projects.length} projects.
          </p>

          <div class:list={['grid gap-5', gridColumns]} data-project-grid>
            {result.projects.map((project, index) => (
              <ProjectCard
                project={project}
                featuredLayout={index === 0}
                priority={index === 0}
              />
            ))}
          </div>

          <div
            hidden
            data-filter-empty
            class="card-elevated flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between"
          >
            <div class="space-y-1">
              <p class="text-title-md text-on-surface">No projects match this filter</p>
              <p class="text-body-md text-on-surface-variant">Reset the category filter to view all entries.</p>
            </div>
            <button type="button" class="btn btn-tonal" data-filter-reset>
              Show all projects
            </button>
          </div>
        </>
      )
    }
  </div>
</section>

<script>
  const filterGroup = document.querySelector<HTMLElement>('[data-project-filters]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
  const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
  const liveStatus = document.querySelector<HTMLElement>('[data-filter-live]');

  function applyFilter(category: string) {
    if (!filterGroup || !grid) return;

    const buttons = filterGroup.querySelectorAll<HTMLButtonElement>('[data-filter]');
    for (const btn of buttons) {
      btn.setAttribute('aria-pressed', btn.dataset.filter === category ? 'true' : 'false');
    }

    let visible = 0;
    for (const card of cards) {
      const match = category === 'All' || card.dataset.category === category;
      card.hidden = !match;
      if (match) visible += 1;
    }

    if (emptyState) emptyState.hidden = visible > 0;
    if (liveStatus) {
      liveStatus.textContent =
        category === 'All'
          ? `Showing all ${visible} projects.`
          : `Showing ${visible} ${category} ${visible === 1 ? 'project' : 'projects'}.`;
    }
  }

  filterGroup?.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-filter]') : null;
    if (target?.dataset.filter) {
      applyFilter(target.dataset.filter);
    }
  });

  resetBtn?.addEventListener('click', () => applyFilter('All'));
</script>
