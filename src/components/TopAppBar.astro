---
import { site } from '../config/site';
import BrandMark from './BrandMark.astro';

interface Props {
  active?: 'home' | 'projects' | 'about' | 'socials';
  brand?: string;
  showAdmin?: boolean;
}

const { active = 'home', brand = site.brand, showAdmin = false } = Astro.props;

const navItems = [
  { id: 'home', label: 'Home', href: '/#top' },
  { id: 'projects', label: 'Projects', href: '/#projects' },
  { id: 'about', label: 'About', href: '/#about' },
  { id: 'socials', label: 'Socials', href: '/#socials' },
] as const;
---

<header class="sticky top-0 z-30 border-b border-outline-variant/50 bg-surface">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="state-layer inline-flex min-h-11 items-center gap-2.5 rounded-full px-3 text-title-md tracking-tight text-on-surface"
    >
      <BrandMark class="size-6 shrink-0 text-on-surface" />
      <span class="font-bold tracking-wide text-on-surface">{brand}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex" data-desktop-nav>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-id={item.id}
            aria-current={active === item.id ? 'page' : undefined}
            class="nav-pill state-layer inline-flex min-h-11 items-center rounded-full px-4 text-label-lg text-on-surface-variant transition-colors aria-[current=page]:bg-secondary-container aria-[current=page]:text-on-secondary-container"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {
      showAdmin && (
        <div class="flex items-center gap-2">
          <a href="/admin" class="btn btn-outlined min-h-11 px-4">Admin</a>
        </div>
      )
    }
  </div>
</header>
