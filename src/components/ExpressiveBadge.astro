---
import Icon, { type IconName } from './Icon.astro';

export type ExpressiveShape = 'clover' | 'pill-tilted' | 'scallop' | 'starburst';

interface Props {
  shape: ExpressiveShape;
  icon: IconName;
  tone?: 'primary' | 'secondary';
  class?: string;
}

const { shape, icon, tone = 'primary', class: className } = Astro.props;

const toneClasses =
  tone === 'primary'
    ? { bg: 'text-primary-container', fg: 'text-on-primary-container' }
    : { bg: 'text-secondary-container', fg: 'text-on-secondary-container' };
---

<span class:list={['expressive-badge relative inline-flex size-12 shrink-0 items-center justify-center', className]} aria-hidden="true">
  <span class="expressive-badge-shape absolute inset-0 size-full">
    {
      shape === 'clover' && (
        <svg viewBox="0 0 296 296" fill="currentColor" data-shape={shape} class:list={['expressive-badge-svg size-full', toneClasses.bg]}>
          <path d="M21.001 148C7.895 132.339 0 112.126 0 90.06 0 40.32 40.113 0 89.595 0c22.395 0 42.871 8.26 58.578 21.913C163.843 8.26 184.271 0 206.614 0 255.981 0 296 40.321 296 90.06c0 22.066-7.877 42.279-20.952 57.94C288.123 163.661 296 183.874 296 205.94c0 49.739-40.019 90.06-89.386 90.06-22.343 0-42.771-8.259-58.441-21.913C132.466 287.741 111.99 296 89.595 296 40.113 296 0 255.679 0 205.94c0-22.066 7.895-42.279 21.001-57.94" />
        </svg>
      )
    }
    {
      shape === 'pill-tilted' && (
        <svg viewBox="0 0 316 316" fill="currentColor" data-shape={shape} class:list={['expressive-badge-svg size-full', toneClasses.bg]}>
          <path d="M84.116 39.785c53.046-53.047 139.052-53.047 192.099 0s53.047 139.053 0 192.099l-44.331 44.331c-53.046 53.047-139.052 53.047-192.099 0s-53.047-139.053 0-192.1z" />
        </svg>
      )
    }
    {
      shape === 'scallop' && (
        <svg viewBox="0 0 76 76" fill="currentColor" data-shape={shape} class:list={['expressive-badge-svg size-full', toneClasses.bg]}>
          <path d="M29.475 4.061c4.463-5.267 12.587-5.267 17.05 0a11.17 11.17 0 0 0 9.445 3.912c6.881-.568 12.625 5.176 12.056 12.057a11.18 11.18 0 0 0 3.913 9.445c5.267 4.463 5.267 12.587 0 17.05a11.18 11.18 0 0 0-3.913 9.445c.569 6.881-5.175 12.625-12.056 12.056a11.18 11.18 0 0 0-9.445 3.913c-4.463 5.267-12.587 5.267-17.05 0a11.18 11.18 0 0 0-9.445-3.913c-6.881.569-12.625-5.175-12.057-12.056a11.17 11.17 0 0 0-3.912-9.445c-5.267-4.463-5.267-12.587 0-17.05a11.17 11.17 0 0 0 3.912-9.445C7.405 13.149 13.149 7.405 20.03 7.973a11.17 11.17 0 0 0 9.445-3.912" />
        </svg>
      )
    }
    {
      shape === 'starburst' && (
        <svg viewBox="0 0 320 320" fill="currentColor" data-shape={shape} class:list={['expressive-badge-svg size-full', toneClasses.bg]}>
          <path d="M246.453 38.812c9.952.676 14.928 1.014 18.951 2.773a25.24 25.24 0 0 1 13.011 13.011c1.759 4.023 2.097 8.999 2.773 18.951l1.544 22.712c.273 4.025.41 6.037.847 7.96a25.3 25.3 0 0 0 3.248 7.84c1.05 1.669 2.376 3.189 5.029 6.229l14.968 17.15c6.56 7.516 9.839 11.274 11.439 15.362a25.23 25.23 0 0 1 0 18.4c-1.6 4.088-4.879 7.846-11.439 15.362l-14.968 17.15c-2.653 3.04-3.979 4.56-5.029 6.229a25.3 25.3 0 0 0-3.248 7.84c-.437 1.923-.574 3.935-.847 7.96l-1.544 22.712c-.676 9.952-1.014 14.928-2.773 18.951a25.24 25.24 0 0 1-13.011 13.011c-4.023 1.759-8.999 2.097-18.951 2.773l-22.712 1.544c-4.025.273-6.037.41-7.96.847a25.3 25.3 0 0 0-7.84 3.248c-1.669 1.05-3.189 2.376-6.229 5.029l-17.15 14.968c-7.516 6.56-11.274 9.839-15.362 11.439a25.23 25.23 0 0 1-18.4 0c-4.088-1.6-7.846-4.879-15.362-11.439l-17.15-14.968c-3.04-2.653-4.56-3.979-6.229-5.029a25.3 25.3 0 0 0-7.84-3.248c-1.923-.437-3.935-.574-7.96-.847l-22.712-1.544c-9.952-.676-14.928-1.014-18.95-2.773a25.24 25.24 0 0 1-13.012-13.011c-1.759-4.023-2.097-8.999-2.773-18.951l-1.544-22.712c-.273-4.025-.41-6.037-.847-7.96a25.2 25.2 0 0 0-3.248-7.84c-1.05-1.669-2.376-3.189-5.03-6.229l-14.967-17.15c-6.56-7.516-9.84-11.274-11.44-15.362a25.24 25.24 0 0 1 0-18.4c1.6-4.088 4.88-7.846 11.44-15.362l14.968-17.15c2.653-3.04 3.979-4.56 5.029-6.229a25.2 25.2 0 0 0 3.248-7.84c.437-1.923.574-3.935.847-7.96l1.544-22.712c.676-9.952 1.014-14.928 2.773-18.95a25.24 25.24 0 0 1 13.011-13.012c4.023-1.759 8.999-2.097 18.951-2.773l22.712-1.544c4.025-.273 6.037-.41 7.96-.847a25.2 25.2 0 0 0 7.84-3.248c1.669-1.05 3.189-2.376 6.229-5.03l17.15-14.967c7.516-6.56 11.274-9.84 15.362-11.44a25.24 25.24 0 0 1 18.4 0c4.088 1.6 7.846 4.88 15.362 11.44l17.15 14.968c3.04 2.653 4.56 3.979 6.229 5.029a25.2 25.2 0 0 0 7.84 3.248c1.923.437 3.935.574 7.96.847z" />
        </svg>
      )
    }
  </span>
  <span class:list={['expressive-badge-icon relative z-10 inline-flex items-center justify-center', toneClasses.fg]}>
    <Icon name={icon} class="size-6" />
  </span>
</span>
